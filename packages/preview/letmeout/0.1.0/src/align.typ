#import "bridge.typ": bridge
#import "css.typ": alignment-styles, direction, fold-alignment

#let html-align(it, outer: start + top) = {
  let styles = (
    "display: grid", "grid-template-columns: minmax(0, 1fr)", "box-sizing: border-box",
    "min-width: 0", "align-self: stretch", "flex: 1 1 auto", "min-height: 0",
  ) + alignment-styles(fold-alignment(outer, it.alignment))
  // No page-sized minimum height. A grid/flex parent can supply free space.
  html.elem("div", attrs: (class: "letmeout-align", dir: direction(), lang: text.lang, style: styles.join("; ")),
    html.elem("div", attrs: (
      class: "letmeout-align-body", style: "min-width: 0; max-width: 100%",
    ), it.body))
}

// Generated by scripts/api-docs.py from the Typst 0.15.1 docs of `align`,
// https://typst.app/docs/reference/layout/align/. Edit scripts/api.toml, not this block.
/// Aligns content horizontally and vertically.
///
/// #quote(block: true)[*Note:* A block that aligns its content with CSS. Paged output
/// is Typst's native alignment, unchanged. Use `std.align` for set and show rules.]
///
/// - alignment (alignment): The alignment along both axes.
///
///   Default: `start + top`. This parameter is positional. \
///   #quote(block: true)[*Note:* In HTML, `left`, `center`, and `right` stay on that
///   side; `start` and `end` follow the text direction. `top`, `horizon`, and `bottom`
///   need free space from a container, such as a grid row: HTML has no page height to
///   align in. Horizontal alignment sets `text-align` and `justify-items`; vertical
///   alignment sets `align-content`. Combined axes apply together; an omitted axis
///   inherits the surrounding native alignment.]
///
/// - body (content): The content to align.
///
///   This parameter is positional. \
///   #quote(block: true)[*Note:* In HTML, selectable content inside a block container.
///   Links and nested supported layouts keep their behavior. Nested alignment can
///   position a group while aligning the text inside it differently. No viewport height
///   is added.]
///
/// -> content
#let align(..args) = bridge(std.align(..args), std.align,
  it => html-align(it, outer: std.align.alignment))
