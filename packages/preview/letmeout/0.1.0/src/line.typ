#import "bridge.typ": bridge
#import "css.typ": size, stroke-value
#import "stroke.typ": stroke-html

#let html-line(it) = {
  let start = it.start.map(v => size(v, percent-unit: "cqw"))
  let end = if it.end != none { it.end.map(v => size(v, percent-unit: "cqw")) }
    else {
      let len = it.length
      (size(it.start.at(0) + len * calc.cos(it.angle), percent-unit: "cqw"),
       size(it.start.at(1) + len * calc.sin(it.angle), percent-unit: "cqw"))
    }
  let dx = "(" + end.at(0) + " - " + start.at(0) + ")"
  let dy = "(" + end.at(1) + " - " + start.at(1) + ")"
  let s = stroke-value(it.stroke)
  let drawing = stroke-html(s, extra:
    "position: absolute; left: " + start.at(0) + "; top: " + start.at(1)
      + "; width: hypot(" + dx + ", " + dy + "); height: " + size(s.thickness)
      + "; transform-origin: 0 50%; transform: translateY(-50%) rotate(atan2(" + dy + ", " + dx + "))")
  // Phrasing tags also stay valid inside inline boxes in paragraphs. A div
  // would make the HTML parser close the paragraph and detach the stroke.
  html.elem("span", attrs: (class: "letmeout-line", "aria-hidden": "true",
    style: "display: block; container-type: inline-size; width: 100%; min-width: 0"),
    html.elem("span", attrs: (style: "display: block; position: relative; height: max(0pt, " + start.at(1) + ", " + end.at(1) + "); padding-bottom: " + size(s.thickness)), drawing))
}

