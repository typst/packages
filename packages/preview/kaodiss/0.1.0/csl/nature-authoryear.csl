<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="sort-only" default-locale="en-US">
  <info>
    <!-- kaodiss: CSL version of the biblatex setup
           bibstyle=nature, citestyle=authoryear, maxcitenames=1, sorting=nyt,
           backref=true (through kaobook's kaobiblio)
         i.e. author-year citations in the text ("Adadi et al. 2018") and a
         numbered bibliography in the style of biblatex-nature, sorted by
         name, year and title. The bibliography part is derived from the
         "Nature" CSL style. -->
    <title>Nature, author-year citations (kaodiss)</title>
    <id>kaodiss-nature-authoryear</id>
    <link href="http://www.zotero.org/styles/nature" rel="template"/>
    <author>
      <name>Michael Berkowitz</name>
    </author>
    <contributor>
      <name>Patrick O'Brien</name>
    </contributor>
    <category citation-format="author-date"/>
    <category field="generic-base"/>
    <updated>2026-10-19T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <locale xml:lang="en">
    <terms>
      <term name="et-al">et al.</term>
    </terms>
  </locale>
  <!-- ===================== citation macros ===================== -->
  <macro name="cite-author">
    <names variable="author">
      <name form="short" and="symbol" delimiter=", "/>
      <et-al font-style="italic"/>
      <substitute>
        <names variable="editor"/>
        <text variable="title-short"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>
  <macro name="cite-year">
    <!-- U+E000 / U+E001 mark the year so that the template can colour it -->
    <group prefix="&#xE000;" suffix="&#xE001;">
      <choose>
        <if variable="issued">
          <date variable="issued">
            <date-part name="year"/>
          </date>
        </if>
        <else>
          <text term="no date" form="short"/>
        </else>
      </choose>
      <text variable="year-suffix"/>
    </group>
  </macro>
  <!-- ===================== bibliography macros ===================== -->
  <macro name="title">
    <choose>
      <if type="bill book graphic legal_case legislation motion_picture report song thesis manuscript document webpage post post-weblog software dataset article" match="any">
        <text variable="title" font-style="italic"/>
      </if>
      <else>
        <text variable="title"/>
      </else>
    </choose>
  </macro>
  <macro name="author">
    <names variable="author">
      <name sort-separator=", " delimiter=", " and="symbol" initialize-with=". " delimiter-precedes-last="never" name-as-sort-order="all"/>
      <label form="short" prefix=" (" suffix=")"/>
      <et-al font-style="italic"/>
      <substitute>
        <names variable="editor"/>
      </substitute>
    </names>
  </macro>
  <macro name="sort-author">
    <names variable="author">
      <name name-as-sort-order="all"/>
      <substitute>
        <names variable="editor"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>
  <macro name="container-title">
    <text variable="container-title" font-style="italic"/>
  </macro>
  <macro name="editor">
    <choose>
      <if type="chapter paper-conference" match="any">
        <names variable="editor" prefix="(" suffix=")">
          <label form="short" suffix=" "/>
          <name and="symbol" delimiter-precedes-last="never" initialize-with=". " name-as-sort-order="all"/>
        </names>
      </if>
    </choose>
  </macro>
  <macro name="volume">
    <choose>
      <if type="article-journal article-magazine article-newspaper" match="any">
        <text variable="volume" font-weight="bold"/>
      </if>
      <else>
        <group delimiter=" ">
          <label variable="volume" form="short"/>
          <text variable="volume"/>
        </group>
      </else>
    </choose>
  </macro>
  <macro name="journal-tail">
    <!-- Journal 41, 124003 (2020) -->
    <group delimiter=" ">
      <group delimiter=", ">
        <group delimiter=" ">
          <text macro="container-title"/>
          <text macro="volume"/>
        </group>
        <text variable="page"/>
      </group>
      <date variable="issued" prefix="(" suffix=")">
        <date-part name="year"/>
      </date>
    </group>
  </macro>
  <macro name="publisher">
    <!-- Typst maps the BibLaTeX fields institution/school to "authority" -->
    <choose>
      <if variable="publisher">
        <text variable="publisher"/>
      </if>
      <else>
        <text variable="authority"/>
      </else>
    </choose>
  </macro>
  <macro name="publication-tail">
    <!-- (Publisher, Place, 2020), 12-34 -->
    <group delimiter=", ">
      <group delimiter=", " prefix="(" suffix=")">
        <text macro="publisher"/>
        <text variable="publisher-place"/>
        <date variable="issued">
          <date-part name="year"/>
        </date>
      </group>
      <text variable="page"/>
    </group>
  </macro>
  <macro name="access">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix="https://doi.org/"/>
      </if>
      <else-if type="article-journal paper-conference chapter book" match="none">
        <text variable="URL"/>
      </else-if>
    </choose>
  </macro>
  <!-- ===================== citation ===================== -->
  <citation et-al-min="2" et-al-use-first="1" disambiguate-add-year-suffix="true" givenname-disambiguation-rule="primary-name">
    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=", ">
        <group delimiter=" ">
          <text macro="cite-author"/>
          <text macro="cite-year"/>
        </group>
        <group delimiter=" ">
          <label variable="locator" form="short"/>
          <text variable="locator"/>
        </group>
      </group>
    </layout>
  </citation>
  <!-- ===================== bibliography ===================== -->
  <bibliography et-al-min="100" et-al-use-first="99" second-field-align="flush" entry-spacing="0">
    <sort>
      <key macro="sort-author"/>
      <key variable="issued"/>
      <key variable="title"/>
    </sort>
    <layout suffix=".">
      <text variable="citation-number" suffix="."/>
      <group delimiter=" ">
        <text macro="author" suffix="."/>
        <choose>
          <if type="article-journal article-magazine article-newspaper" match="any">
            <text macro="title" suffix="."/>
            <text macro="journal-tail"/>
          </if>
          <else-if type="chapter paper-conference" match="any">
            <text macro="title"/>
            <group delimiter=" ">
              <text term="in"/>
              <text macro="container-title"/>
              <text macro="editor"/>
            </group>
            <text macro="publication-tail"/>
          </else-if>
          <else-if type="thesis">
            <text macro="title"/>
            <group delimiter=" ">
              <text variable="genre"/>
              <group delimiter=", " prefix="(" suffix=")">
                <text macro="publisher"/>
                <date variable="issued">
                  <date-part name="year"/>
                </date>
              </group>
            </group>
          </else-if>
          <else-if type="book report" match="any">
            <text macro="title"/>
            <group delimiter=" ">
              <number variable="edition" form="ordinal" suffix=" ed."/>
              <text variable="number" prefix="tech. rep. "/>
            </group>
            <text macro="publication-tail"/>
          </else-if>
          <else>
            <text macro="title"/>
            <text variable="container-title"/>
            <text variable="number"/>
            <date variable="issued" suffix=".">
              <date-part name="year"/>
            </date>
          </else>
        </choose>
        <text macro="access"/>
        <text variable="citation-key" prefix="&#xE002;" suffix="&#xE003;"/>
      </group>
    </layout>
  </bibliography>
</style>
