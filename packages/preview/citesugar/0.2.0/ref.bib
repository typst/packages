@incollection{schwarz2019weakvsstrong,
  abstract = {One line of recent work on definite articles has been concerned with languages{\textbackslash textless}br{\textbackslash textgreater} that utilize different forms for definite descriptions of different types. In the first{\textbackslash textless}br{\textbackslash textgreater} part of this paper, I discuss the semantic analysis of the underlying distinction of{\textbackslash textless}br{\textbackslash textgreater} weak and strong definite articles as proposed in Schwarz (2009), which formalizes{\textbackslash textless}br{\textbackslash textgreater} the contrast in terms of uniqueness (for weak articles) vs. anaphoricity (for strong{\textbackslash textless}br{\textbackslash textgreater} articles). I also review the empirical motivation for the analysis based on German{\textbackslash textless}br{\textbackslash textgreater} preposition-determiner contraction and its implications for related semantic phe-{\textbackslash textless}br{\textbackslash textgreater} nomena. The second part of the paper surveys recent advances in documenting{\textbackslash textless}br{\textbackslash textgreater} contrasts between definites in various other languages. One issue here will be on{\textbackslash textless}br{\textbackslash textgreater} assessing to what extent the cross-linguistic contrasts are uniform in terms of their{\textbackslash textless}br{\textbackslash textgreater} semantics and pragmatics, and to what extent there is variation in the relevant{\textbackslash textless}br{\textbackslash textgreater} patterns. A second issue is to evaluate how the obvious variation in the formal{\textbackslash textless}br{\textbackslash textgreater} realization of the contrast across languages can contribute to a more refined imple-{\textbackslash textless}br{\textbackslash textgreater} mentation of the contrast in meaning.},
  author = {Schwarz, Florian},
  doi = {10.5281/ZENODO.3252012},
  langid = {english},
  month = {6},
  publisher = {Zenodo},
  shorttitle = {Weak vs. strong definite articles},
  title = {Weak vs. strong definite articles: Meaning and form across languages},
  url = {https://zenodo.org/record/3252012},
  urldate = {2024-01-31},
  year = {2019},
}

