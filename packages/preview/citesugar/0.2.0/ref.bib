@unpublished{loreauunger2024towardtopologicaltheoryaspectual,
  abstract = {I present a mathematically intelligible theory of event conceptualization, known
as lexical aspect within linguistics, based on Croft’s (2012, <i>Verbs: Aspect and
Causal Structure</i>, OUP) diagram-based account. Croft defined aspectual types
using sequences of qualitative states, giving full status to the qualitative
component of the unfolding of events. I make this idea formal using objects from
general topology, by defining each aspectual type as the conjunction of a
qualitative topological space, together with a continuous trajectory within that
space. The topology on the space only distinguishes qualitative states inasmuch
as they differ with respect to the unfolding of the event, discarding otherwise
irrelevant distinctions between event types. Continuous transformations can
change one space into another by collapsing distinctions, regimenting the shifts
in granularity proposed by Croft for aspectual coercion. This preliminary, more
constrained framework for event conceptualization already allows us to evaluate
existing aspectual distinctions and operations, and conjecture new ones. In
light of this theory, I differ from Croft in my treatment of semelfactives,
arguing that they are telic predicates with a special activity reading, similar
to Rothstein (2008, \textquotedblleft Two puzzles for a theory of lexical aspect: Semelfactives
and Degree Achievements\textquotedblright ), who proposed semelfactives were activity predicates
with naturally atomic minimal events. I also deny aspectual status to
nonincremental accomplishments (<i>solve the puzzle</i>) and irreversibility,
suggesting that the proposed diagnostics are sensitive to other inference-making
mechanisms. Finally, I conjecture transformations to explain the effect of
aspectual verbs, which could conceivably help formulate an algorithm for
computing the presuppositions of these soft triggers, based on the aspectual
representations provided by the theory.},
  author = {Loreau Unger, Baptiste},
  keywords = {aspect, aspectual coercion, general topology, conceptual spaces, events, semantics},
  month = {9},
  note = {Published in: Master’s thesis, Universit{\'e} Paris Cit{\'e}},
  title = {Toward a topological theory of the aspectual conceptualization of events},
  url = {https://ling.auf.net/lingbuzz/008561},
  year = {2024},
}

@article{slaats2025whatssurprisingaboutsurprisal,
  abstract = {<jats:title>Abstract</jats:title>
          <jats:p>In the computational and experimental psycholinguistic literature, the mechanisms behind syntactic structure building (e.g., combining words into phrases and sentences) are the subject of considerable debate. Much experimental work has shown that surprisal is a good predictor of human behavioral and neural data. These findings have led some authors to model language comprehension in a purely probabilistic way. In this paper, we use simulation to exemplify why surprisal works so well to model human data and to illustrate why exclusive reliance on it can be problematic for the development of mechanistic theories of language comprehension, particularly those with emphasis on meaning composition. Rather than arguing for the importance of structural or probabilistic information to the exclusion or exhaustion of the other, we argue more emphasis should be placed on understanding how the brain leverages both types of information (viz., statistical and structured). We propose that probabilistic information is an important <jats:italic>cue</jats:italic> to the structure in the message, but is not a substitute for the structure itself\textemdash neither computationally, formally, nor conceptually. Surprisal and other probabilistic metrics must play a key role as theoretical objects in any explanatory mechanistic theory of language processing, but that role remains in the service of the brain’s goal of constructing structured meaning from sensory input.</jats:p>},
  author = {Slaats, Sophie and Martin, Andrea E.},
  doi = {10.1007/s42113-025-00237-9},
  issue = {2},
  journal = {Computational Brain \&amp; Behavior},
  language = {en},
  month = {6},
  pages = {233--248},
  publisher = {Springer Science and Business Media LLC},
  title = {What’s Surprising About Surprisal},
  url = {https://doi.org/10.1007/s42113-025-00237-9},
  volume = {8},
  year = {2025},
}

