@article{partee2009formalsemanticslexical,
  abstract = {The focus of the paper is the interaction of meaning and context with different kinds of adjectives. Adjective meanings are shown to be more constrained than was appreciated in earlier work. Facts about \textquotedblleft {NP}-splitting\textquotedblright  in Polish and Russian cast serious doubt on the standard hierarchy of adjectives, and the data become much more orderly if privative adjectives are reanalyzed as subsective adjectives. This revised account requires the possibility of coerced expansion of the denotation of the noun to which an adjective is applied. Compositionality can be seen as one of the driving forces in such context-sensitive meaning shifts.},
  author = {Partee, Barbara H.},
  issn = {1820-5682},
  journaltitle = {Philologia},
  langid = {english},
  note = {Number: 1},
  number = {1},
  pages = {1--24},
  shorttitle = {Formal Semantics, Lexical Semantics, and Compositionality},
  title = {Formal Semantics, Lexical Semantics, and Compositionality: The Puzzle of Privative Adjectives},
