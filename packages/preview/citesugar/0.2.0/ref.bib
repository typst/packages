@unpublished{goodale2026whateverhappenedmeaninga,
  abstract = {<p>A version of this manuscript was submitted to Behavioral and Brain Sciences as a commentary on Futrell and Mahowald’s (forthcoming) \textquotedblleft How linguistics learned to stop worrying and embrace the language models.\textquotedblright </p>
<p>By \textquotedblleft linguistics,\textquotedblright  the target article means usage-based linguistics, which, we agree, plays very well with language models.  But the article summarily dismisses important work on <em>meaning</em> from the now disreputable tradition of generative linguistics.  We refute the authors’ arguments from distributional semantics and \textquotedblleft green tea,\textquotedblright  and highlight the importance of formal compositional semantics for the study of thought.</p><p></p>},
