@article{heycock2012specificationequationagreement,
  abstract = {This article presents new data from a number of Germanic languages concerning the agreement patterns found in copular clauses that contain two nominals; in both clauses with specificational readings (such as The problem is your parents) and those with what are here termed readings of assumed identity (such as If I were you or In my dream I was you). It is argued that the specificational sentences involve asymmetric equative structures where one nominal is interpreted as in a concealed question, and that the cross-linguistic differences in agreement patterns found in the languages considered follow from the copula lexicalizing either Tense or a lower head., Cet article pr{\'e}sente de nouvelles donn{\'e}es tir{\'e}es de certaines langues germaniques et qui illustrent les sch{\'e}mas d\textquotesingle accord dans les propositions copulatives avec deux substantifs ; les propositions {\`a} lecture sp{\'e}cificationnelle (telles que The problem is your parents) ainsi que celles {\`a} \guillemotleft lecture d\textquotesingle identit{\'e} emprunt{\'e}e\guillemotright  (telle que If I were you ou In my dream I was you). L\textquotesingle article propose que les phrases sp{\'e}cificationnelles comprennent des structures {\'e}quatives asym{\'e}triques o{\`u} un substantif est interpr{\'e}t{\'e} exactement comme dans le contexte d\textquotesingle une question furtive, et que les diff{\'e}rences interlinguistiques dans les sch{\'e}mas d\textquotesingle accord relev{\'e}s dans les langues sous consid{\'e}ration d{\'e}coulent de la lexicalisation par la copule de la t{\^e}te tens{\'e}e T0 ou d\textquotesingle une t{\^e}te plus basse dans la structure.},
  author = {Heycock, Caroline},
  issn = {1710-1115},
  journaltitle = {The Canadian Journal of Linguistics / La revue canadienne de linguistique},
  note = {Publisher: Cambridge University Press},
  number = {2},
  pages = {209--240},
  title = {Specification, equation, and agreement in copular sentences},
