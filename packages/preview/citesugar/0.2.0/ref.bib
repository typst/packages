@article{champollion2015interactioncompositionalsemantics,
  abstract = {Davidsonian event semantics is often taken to form an unhappy marriage with compositional semantics. For example, it has been claimed to be problematic for semantic accounts of quantiﬁcation (Beaver and Condoravdi, in: Aloni et al. (eds.) Proceedings of the 16th Amsterdam Colloquium, 2007), for classical accounts of negation (Krifka, in: Bartsch et al. (eds.) Semantics and contextual expression, 1989), and for intersective accounts of verbal coordination (Lasersohn, in Plurality, conjunction and events, 1995). This paper shows that none of this is the case, once we abandon the idea that the event variable is bound at sentence level, and assume instead that verbs denote existential quantiﬁers over events. Quantiﬁcational arguments can then be given a semantic account, negation can be treated classically, and coordination can be modeled as intersection. The framework presented here is a natural choice for researchers and ﬁeldworkers who wish to sketch a semantic analysis of a language without being forced to make commitments about the hierarchical order of arguments, the argument-adjunct distinction, the default scope of quantiﬁers, or the nature of negation and coordination.},
  author = {Champollion, Lucas},
  doi = {10.1007/s10988-014-9162-8},
  issn = {0165-0157, 1573-0549},
  journaltitle = {Linguistics and Philosophy},
  langid = {english},
  month = {2},
  number = {1},
  pages = {31--66},
  shortjournal = {Linguist and Philos},
  title = {The interaction of compositional semantics and event semantics},
  url = {http://link.springer.com/10.1007/s10988-014-9162-8},
  urldate = {2024-01-31},
  volume = {38},
  year = {2015},
}

