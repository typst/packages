  shorttitle = {Broaden Your Views},
  title = {Broaden Your Views: Implicatures of Domain Widening and the \textquotedblleft Logicality\textquotedblright  of Language},
  url = {https://ieeexplore.ieee.org/abstract/document/6795906},
  urldate = {2025-05-27},
  volume = {37},
  year = {2006},
}

@article{aguilarguevara2010weakdefinitesreference,
  abstract = {Weak definite {NPs} do not presuppose the existence of uniquely identifiable entities. In addition, they display a range of other peculiar properties such as sloppy readings in {VPs} ellipsis, narrow scope interpretations, lexical restrictions and enriched meaning. In order to account for these, in this paper we analyze weak definites as expressions that refer to the same sort of kind individuals that definite generics refer to. We propose that the combination of weak definites with object-level predicates is made possible by a lexical rule that lifts object-level relations to \textquotesingle enriched\textquotesingle  kind-level relations.},
  author = {Aguilar-Guevara, Ana and Zwarts, Joost},
  doi = {10.3765/salt.v20i0.2583},
  issn = {2163-5951},
  journaltitle = {Semantics and Linguistic Theory},
