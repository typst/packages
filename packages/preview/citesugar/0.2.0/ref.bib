@article{barany2021adjoinedpossessors,
  abstract = {External and internal possessors differ from each other in several properties. In contrast to internal possessors, external possessors do not form a constituent with the possessed noun and can participate in clause-level processes such as verb agreement and switch-reference. In this squib, we discuss \textquotedblleft intermediate\textquotedblright  possessors with both internal and external properties. In Tundra Nenets (Uralic), such possessors form a syntactic constituent with the possessed noun but show different types of clause-level behavior. They can bind and control out of their host {DP} and participate in an obviation system, a consequence of the possessor being adjoined to the host {DP}.},
