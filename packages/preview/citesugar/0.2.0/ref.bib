@book{elbourne2005situationsindividuals,
  abstract = {In Situations and Individuals, Paul Elbourne argues that the natural language expressions that have been taken to refer to individuals -- pronouns, proper names, and definite descriptions -- have a common syntax and semantics, roughly that of definite descriptions as construed in the tradition of Frege. In the course of his argument, Elbourne shows that proper names have previously undetected donkey anaphoric readings.This is contrary to previous theorizing and, if true, would undermine what philosophers call the direct reference theory (which holds that the sole contribution of a proper name to the truth conditions of a sentence is an individual) as well as the related doctrine that proper names are rigid designators. Elbourne begins by addressing donkey anaphora, relating other concerns about pronouns to the solution of this notorious problem. His subsequent argumentation provides a unified semantics for the donkey anaphoric and bound and referential uses of pronouns and discusses the prospect of unifying the syntax and semantics of pronouns with the syntax and semantics of normal definite descriptions. Elbourne\textquotesingle s aim is not only to advance his proposal of a unified syntax and semantics but also to urge linguists and philosophers dealing with pronoun interpretation to consider a wider range of theories than they do at present, and to test the competing claims of description-based theories and dynamic semantics against the data.},
  author = {Elbourne, Paul D.},
  isbn = {978-0-262-05080-7},
  langid = {english},
  note = {Google-Books-{ID}: Z\textbackslash \_lkAAAAMAAJ},
  pagetotal = {256},
  publisher = {Massachusetts Institute of Technology},
  title = {Situations and Individuals},
  year = {2005},
}

