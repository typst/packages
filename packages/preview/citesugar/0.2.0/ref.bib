  shorttitle = {Lexical Meaning in Context},
  title = {Lexical Meaning in Context: A Web of Words},
  year = {2011},
}

@article{fodor1988connectionismcognitivearchitecture,
  abstract = {This paper explores differences between Connectionist proposals for cognitive architecture and the sorts of models that have traditionally been assumed in cognitive science. We claim that the major distinction is that, while both Connectionist and Classical architectures postulate representational mental states, the latter but not the former are committed to a symbol-level of representation, or to a ‘language of thought’: i.e., to representational states that have combinatorial syntactic and semantic structure. Several arguments for combinatorial structure in mental representations are then reviewed. These include arguments based on the ‘systematicity’ of mental representation: i.e., on the fact that cognitive capacities always exhibit certain symmetries, so that the ability to entertain a given thought implies the ability to entertain thoughts with semantically related contents. We claim that such arguments make a powerful case that mind/brain architecture is not Connectionist at the cognitive level. We then consider the possibility that Connectionism may provide an account of the neural (or ‘abstract neurological’) structures in which Classical cognitive architecture is implemented. We survey a number of the standard arguments that have been offered in favor of Connectionism, and conclude that they are coherent only on this interpretation.
R{\'e}sum{\'e}
Cet article{\'e}tudie les diff{\'e}rences entre mod{\`e}les connectionistes et mod{\`e}les classiques de la structure cognitive. Nous pensons que, bien que les deux types de mod{\`e}les stipulent l\textquotesingle existence d\textquotesingle {\'e}tats mentaux repr{\'e}sentationnels, la diff{\'e}rence essentielle est que seuls les mod{\`e}les classiques requi{\`e}rent l\textquotesingle existence d\textquotesingle un niveau de repr{\'e}sentation symbolique\textemdash un \textquotedblleft langage de la pens{\'e}e\textquotedblright \textemdash , c\textquotesingle est-{\`a}-dire d\textquotesingle {\'e}tats repr{\'e}sentationnels poss{\'e}dant une structure syntaxique et s{\'e}mantique. Nous examinons ensuite diff{\'e}rents arguments qui militent en faveur de l\textquotesingle existence de repr{\'e}sentations mentales ayant ces propri{\'e}t{\'e}s. Certains de ces arguments reposent sur la \textquotedblleft syst{\'e}maticit{\'e}\textquotedblright  des repr{\'e}sentations mentales, c\textquotesingle est-{\`a}-dire sur le fait que les capacit{\'e}s cognitives exhibent toujours certaines sym{\'e}tries, de sorte que la capacit{\'e}d\textquotesingle entretenir certaines pens{\'e}es implique la capacit{\'e}d\textquotesingle entretenir d\textquotesingle autres pens{\'e}es apparent{\'e}es par leur contenu s{\'e}mantique. Nous pensons que ces arguments montrent de mani{\`e}re convainquante que l\textquotesingle architecture de l\textquotesingle esprit/du cerveau n\textquotesingle est pas connectioniste au niveau cognitif. Nous nous demandons ensuite s\textquotesingle il est possible d\textquotesingle interpr{\'e}ter le connectionisme comme une analyse des structures neuronales (ou des structures neurologiques \textquotedblleft abstraites\textquotedblright ) dans lesquelles est r{\'e}alis{\'e}e l\textquotesingle architecture cognitive classique. Nous examinons plusieurs des arguments avanc{\'e}s habituellement en d{\'e}fense du connectionisme, et en concluons que ceux-ci n\textquotesingle ont de sens que dans cette interpr{\'e}tation.},
  author = {Fodor, Jerry A. and Pylyshyn, Zenon W.},
  doi = {10.1016/0010-0277(88)90031-5},
  issn = {0010-0277},
  journaltitle = {Cognition},
  month = {3},
  number = {1},
  pages = {3--71},
  shortjournal = {Cognition},
  shorttitle = {Connectionism and cognitive architecture},
  title = {Connectionism and cognitive architecture: A critical analysis},
  url = {https://www.sciencedirect.com/science/article/pii/0010027788900315},
  urldate = {2025-01-24},
  volume = {28},
  year = {1988},
}

