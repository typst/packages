@article{rullmann2008modalsdistributiveindefinites,
  abstract = {Modals in St’a\textasciiacute t’imcets (Lillooet Salish) show two differences from their counterparts in English. First, they have variable quantiﬁcational force, systematically allowing both possibility and necessity interpretations; and second, they lexically restrict the conversational background, distinguishing for example between deontic and (several kinds of) epistemic modality. We provide an analysis of the St’a\textasciiacute t’imcets modals according to which they are akin to speciﬁc indeﬁnites in the nominal domain. They introduce choice function variables which select a subset of the accessible worlds. Following Klinedinst, we assume distributivity over the resulting set of worlds. St’a\textasciiacute t’imcets modals thus receive a uniform interpretation as (distributive) pluralities. The appearance of variability in modal force arises because the choice function can select a larger or smaller subset of accessible worlds. Finally, we discuss the implications of our analysis for the investigation of modal systems in other languages.},
  author = {Rullmann, Hotze and Matthewson, Lisa and Davis, Henry},
  doi = {10.1007/s11050-008-9036-0},
  issn = {0925-854X, 1572-865X},
  journaltitle = {Natural Language Semantics},
