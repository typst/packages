@unpublished{spector2025trivalencetransparency,
  abstract = {This paper offers a new theory of singular donkey anaphora that does not include any dynamic component. Even if the approach is not dynamic, it retains a key aspect of the dynamic tradition, namely the view that information states include not just factual information about the world, but also information about discourse referents, e.g., variables. It also makes crucial use of plural assignment functions (sets of standard assignments, cf. van der Berg 1996; Nouwen 2003; Brasoveanu 2008). Unlike dynamic approaches, sentences are evaluated as true or false relative to a pair (w, G), where w is a possible world and G is a plural assignment, with no reference to contexts or information states, and compositional semantics does not refer in any way to context update or transitions between assignments. In order to predict adequate meanings and felicity conditions, I combine two ingredients that have been used to account for presupposition projection, namely Trivalence (Peters 1979; Beaver and Krahmer 2001) and Schlenker’s Transparency Principle (Schlenker 2007,2008).

Two ideas play a crucial role in the proposal. First, a sentence such as \textasciigrave She\_x came\textquotesingle  comes with the presupposition that the variable x is valued and is assigned exactly one atomic individual by the assignment function G, i.e. at least one atomic assignment of G is defined for x, and every atomic assignment in G which is defined for x maps x to the same atomic individual. Second I adopt Mandelkern\textquotesingle s (2022) witness condition: an existential statement such as \textasciigrave Someone\_x came\textquotesingle  is undefined in (w,G) if it is classically true in w but G does not map x to a witness of the existential statement. Undefinedness is not equated with Presupposition Failure. Rather, presupposition projection is governed by Schlenker\textquotesingle s (2007, 2008) Transparency Principle: the presupposition \textasciigrave x is valued and atomic\textquotesingle  should be redundant in the syntactic position in which \textasciigrave She\_x came\textquotesingle  occurs.

In the end of the paper, I discuss well-known ambiguities with donkey sentences (weak vs. strong, existential vs. universal readings) and show how they can be addressed in my system.

The theory is presented as a non-standard semantics for first-order logic, rather than a fragment of a natural language. Free variables are the counterparts of syntactically unbound singular pronouns, and existential quantifiers those of singular indefinites.},
  author = {Spector, Benjamin},
  keywords = {anaphora, presupposition, dynamic semantics, trivalent logic, semantics},
  month = {11},
  note = {Published in: To appear, Linguistics \& Philosophy},
  title = {Trivalence and Transparency: a non-dynamic approach to anaphora},
  url = {https://ling.auf.net/lingbuzz/008396},
  year = {2025},
}

