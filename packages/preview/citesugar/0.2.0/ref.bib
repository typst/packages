@article{burukina2024bigdpanalysis,
  abstract = {This paper develops a novel analysis of \textbackslash \&egrave;to copular constructions in Russian. First, we address\textbackslash \&nbsp;\textbackslash \&lsquo;{NOMpre}\textbackslash \&nbsp;\textbackslash \&egrave;to {NOMpost}\textbackslash \&rsquo; constructions, where {NOM} is a nominative noun phrase. We propose that\textbackslash \&nbsp;there are two predication relations established in such clauses: one on the clausal level, with\textbackslash \&nbsp;{NOMpost} being the subject of predication, and another one within the constituent headed by\textbackslash \&nbsp;\textbackslash \&egrave;to. The latter, we argue, constitutes a \textbackslash \&lsquo;big {DP}\textbackslash \&rsquo;: it contains {NOMpre} in the specifier position and\textbackslash \&nbsp;pro in the complement position of D0; a predication relation is established between the two\textbackslash \&nbsp;with the help of the predicativizer \textbackslash \&egrave;to. The analysis is extended to account for \textbackslash \&lsquo;\textbackslash \&egrave;to {NOMpost}\textbackslash \&rsquo;\textbackslash \&nbsp;constructions. The proposal goes against treating \textbackslash \&egrave;to in \textbackslash \&lsquo;({NOMpre}) \textbackslash \&egrave;to {NOMpost}\textbackslash \&rsquo; constructions\textbackslash \&nbsp;as the subject of predication or as a dedicated functional head on the clausal spine; it also\textbackslash \&nbsp;explicitly rejects treating {NOMpre} in all \textbackslash \&lsquo;({NOMpre}) \textbackslash \&egrave;to {NOMpost}\textbackslash \&rsquo; constructions as a hanging topic. The\textbackslash \&nbsp;proposed analysis captures all the relevant properties of \textbackslash \&egrave;to constructions and makes important\textbackslash \&nbsp;predictions about their distribution, the agreement pattern, and the properties of {NOMpost}. The\textbackslash \&nbsp;\textbackslash \&lsquo;big {DP}\textbackslash \&rsquo; approach also allows us to establish a link between \textbackslash \&egrave;to copular constructions and\textbackslash \&nbsp;specificational pseudo-clefts.},
  author = {Burukina, Irina and Borise, Lena and Dikken, Marcel den},
  doi = {10.16995/glossa.9440},
  issn = {2397-1835},
  journaltitle = {Glossa: a journal of general linguistics},
  month = {6},
  note = {Number: 1
Publisher: Open Library of Humanities},
  number = {1},
  title = {A ‘big DP’ analysis of Russian copular constructions with {\`e}to},
  url = {https://www.glossa-journal.org/article/id/9440/},
  urldate = {2025-02-23},
  volume = {9},
  year = {2024},
}

