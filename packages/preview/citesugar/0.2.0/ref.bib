@book{levin2005argumentrealization,
  abstract = {<jats:p>The relationship between verbs and their arguments is a widely debated topic in linguistics. This comprehensive 2005 survey provides an overview of this important area of research, exploring theories of how a verb\textquotesingle s semantics can determine the morphosyntactic realization of its arguments. Assuming a close connection between verb meaning and syntactic structure, it provides a bridge between lexical-semantic and syntactic research, synthesizing the results of work from a range of linguistic subdisciplines and in a variety of theoretical frameworks. The first four chapters survey leading theories about event structure and conceptualization. The fifth and sixth chapters focus on the mapping from lexical semantics to morphosyntax and include a detailed discussion of the thematic hierarchy. The final chapter reviews treatments of multiple argument realization. With useful bibliographic references and clear definitions of relevant terms, this book will be invaluable to students and researchers in syntax and semantics, as well as those in related fields.</jats:p>},
  author = {Levin, Beth and Rappaport Hovav, Malka},
