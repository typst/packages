@incollection{deal2017externalpossessionpossessor,
  abstract = {Abstract
External possession is a phenomenon where a nominal is syntactically encoded as a verbal dependent but semantically understood as the possessor of one of its co‐arguments. While the general pattern is cross‐linguistically very common, there is much variation in its precise syntax and semantics. In this chapter, I review the classic analyses of external possession as possessor raising and possessor binding. The evidence behind these analyses indicates that raising and binding are indeed each appropriate for certain subtypes of external possession, as is an analysis in terms of movement to thematic positions. I propose a typology that groups these analyses under the first of two major types of external possession. This first type presents significant parallels to the domain of raising and control, subsuming possessor raising, possessor binding, possessor control, and a variant of exceptional case marking ({ECM}). Examples are found in Nez Perce, German, Brazilian Portuguese, and English. A second major type of external possession involves subjects only and brings information structural effects. Examples are found in Malagasy, Chickasaw, Tz\textquotesingle utujil, and Japanese.},
  author = {Deal, Amy Rose},
  booktitle = {The Wiley Blackwell Companion to Syntax, Second Edition},
  doi = {10.1002/9781118358733.wbsyncom047},
  edition = {1},
  editor = {Everaert, Martin and Riemsdijk, Henk C.},
  isbn = {978-1-118-35872-6 978-1-118-35873-3},
  langid = {english},
  month = {11},
  pages = {1--32},
