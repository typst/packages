#let space(base: 1.6cm) = (
  lg: base * 2,
  base: base,
  md: base / 2,
  sm: base / 4,
  xs: base / 8,
)

#let font(base: 16pt) = (
  xxl: base * 3.,
  xl: base * 2.25,
  lg: base * 1.5,
  base: base,
  sm: base * .75,
)

#let weight(base: 1pt) = (
  xl: base * 4,
  lg: base * 2,
  base: base,
  sm: base * .5,
)