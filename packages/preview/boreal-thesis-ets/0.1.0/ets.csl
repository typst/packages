<?xml version="1.0" encoding="utf-8"?>
<!--
  Style bibliographique APA-ÉTS (École de technologie supérieure).

  Porté sur :
    - le guide officiel de la bibliothèque de l'ÉTS
      https://bibliotheque.etsmtl.ca/Services/Bibliographies-et-citations/Citer-avec-le-style-APA-ETS
    - le style BibTeX bibETS.bst livré avec le gabarit LaTeX thETS.

  Forme générale (auteur-date) :
    Nom, P. P., Nom, P. & Nom, P. (Année). Titre. Complément. Lieu: Éditeur. Repéré à URL

  Les libellés français sont dans <locale xml:lang="fr">, les anglais dans
  <locale xml:lang="en"> ; Typst choisit selon le `lang` du document.
-->
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0"
       default-locale="fr-CA"
       demote-non-dropping-particle="never"
       page-range-format="expanded">
  <info>
    <title>École de technologie supérieure (APA-ÉTS)</title>
    <title-short>APA-ÉTS</title-short>
    <id>https://www.etsmtl.ca/csl/apa-ets</id>
    <link href="https://www.etsmtl.ca/csl/apa-ets" rel="self"/>
    <link href="https://bibliotheque.etsmtl.ca/Services/Bibliographies-et-citations/Citer-avec-le-style-APA-ETS" rel="documentation"/>
    <category citation-format="author-date"/>
    <category field="engineering"/>
    <summary>Style APA adapté par la bibliothèque de l'ÉTS (équivalent CSL de bibETS.bst).</summary>
    <updated>2026-09-19T00:00:00+00:00</updated>
  </info>

  <locale xml:lang="fr">
    <date form="text">
      <date-part name="day" suffix=" "/>
      <date-part name="month" form="long"/>
    </date>
    <date form="numeric">
      <date-part name="year"/>
      <date-part name="month" form="numeric-leading-zeros" prefix="-"/>
      <date-part name="day" form="numeric-leading-zeros" prefix="-"/>
    </date>
    <terms>
      <term name="no date">s.d.</term>
      <term name="and">et</term>
      <term name="in">dans</term>
      <term name="retrieved">repéré</term>
      <term name="from">à</term>
      <term name="accessed">le</term>
      <term name="presented at">présentée à</term>
      <term name="page-range-delimiter">-</term>
      <term name="ordinal">e</term>
      <term name="ordinal-01">re</term>
      <term name="edition" form="short">éd.</term>
      <term name="editor" form="short">
        <single>Éd.</single>
        <multiple>Éds.</multiple>
      </term>
      <term name="page" form="short">
        <single>p.</single>
        <multiple>pp.</multiple>
      </term>
      <term name="volume" form="short">vol.</term>
      <term name="chapter" form="short">ch.</term>
      <term name="issue" form="short">n&#xB0;</term>
    </terms>
  </locale>

  <locale xml:lang="en">
    <date form="text">
      <date-part name="month" form="long" suffix=" "/>
      <date-part name="day"/>
    </date>
    <date form="numeric">
      <date-part name="year"/>
      <date-part name="month" form="numeric-leading-zeros" prefix="-"/>
      <date-part name="day" form="numeric-leading-zeros" prefix="-"/>
    </date>
    <terms>
      <term name="no date">n.d.</term>
      <term name="in">in</term>
      <term name="retrieved">retrieved</term>
      <term name="from">from:</term>
      <term name="accessed">on</term>
      <term name="presented at">presented in</term>
      <term name="page-range-delimiter">-</term>
      <term name="edition" form="short">ed.</term>
      <term name="editor" form="short">
        <single>Ed.</single>
        <multiple>Eds.</multiple>
      </term>
      <term name="volume" form="short">vol.</term>
      <term name="chapter" form="short">ch.</term>
      <term name="issue" form="short">no.</term>
    </terms>
  </locale>

  <!-- ============================ Auteurs ============================ -->

  <!-- Bibliographie : « Nom, P. P. », tous les auteurs en ordre inverse,
       séparés par des virgules, le dernier introduit par « & ». La virgule
       devant « & » n'apparaît qu'à partir de trois noms (règle APA). -->
  <macro name="author">
    <choose>
      <if variable="author editor" match="any">
        <names variable="author">
          <name name-as-sort-order="all" sort-separator=", " initialize-with=". "
                and="symbol" delimiter=", " delimiter-precedes-last="contextual"/>
          <substitute>
            <names variable="editor"/>
          </substitute>
        </names>
        <!-- « (Éd.) » / « (Éds.) » lorsque l'ouvrage n'a pas d'auteur. -->
        <choose>
          <if variable="author" match="none">
            <names variable="editor">
              <name form="count"/>
              <label form="short" prefix=" (" suffix=")"/>
            </names>
          </if>
        </choose>
      </if>
      <!-- Ni auteur ni éditeur : l'organisme (organization/institution) fait
           office d'auteur, comme dans bibETS.bst (normes, rapports, sites). -->
      <else-if variable="authority">
        <text variable="authority"/>
      </else-if>
    </choose>
  </macro>

  <!-- Citation dans le texte : nom de famille seul, « et al. » dès 3 auteurs. -->
  <macro name="author-short">
    <choose>
      <if variable="author editor" match="any">
        <names variable="author">
          <name form="short" and="symbol" delimiter=", "
                delimiter-precedes-last="contextual"/>
          <substitute>
            <names variable="editor"/>
          </substitute>
        </names>
      </if>
      <else-if variable="authority">
        <text variable="authority"/>
      </else-if>
      <else>
        <text variable="title" form="short" font-style="italic"/>
      </else>
    </choose>
  </macro>

  <macro name="author-sort">
    <choose>
      <if variable="author editor" match="any">
        <names variable="author">
          <name name-as-sort-order="all" sort-separator=", "/>
          <substitute>
            <names variable="editor"/>
          </substitute>
        </names>
      </if>
      <else-if variable="authority">
        <text variable="authority"/>
      </else-if>
      <else>
        <text variable="title"/>
      </else>
    </choose>
  </macro>

  <!-- Éditeurs intellectuels cités après « Dans ». -->
  <macro name="editors-in">
    <names variable="editor">
      <name name-as-sort-order="all" sort-separator=", " initialize-with=". "
            and="symbol" delimiter=", " delimiter-precedes-last="contextual"/>
      <label form="short" prefix=" (" suffix=")"/>
    </names>
  </macro>

  <!-- ============================== Date ============================== -->

  <macro name="year">
    <choose>
      <if variable="issued">
        <date variable="issued">
          <date-part name="year"/>
        </date>
      </if>
      <else>
        <text term="no date"/>
      </else>
    </choose>
    <text variable="year-suffix"/>
  </macro>

  <!-- « (1999) » ; « (1999, 2 octobre) » pour les documents datés au jour
       (communications, pages web, quotidiens), comme format.year.month.day.par. -->
  <macro name="issued">
    <group prefix="(" suffix=")">
      <text macro="year"/>
      <choose>
        <if type="paper-conference webpage post post-weblog speech broadcast article-newspaper article-magazine" match="any">
          <date variable="issued" form="text" prefix=", "/>
        </if>
      </choose>
    </group>
  </macro>

  <!-- ============================= Titres ============================= -->

  <!-- Italique pour les documents autonomes, romain pour les parties d'un
       ensemble (article, chapitre, communication publiée, page web). -->
  <macro name="title">
    <choose>
      <if type="chapter article-journal article-magazine article-newspaper webpage post post-weblog entry entry-dictionary entry-encyclopedia" match="any">
        <text variable="title"/>
      </if>
      <else-if type="paper-conference">
        <choose>
          <!-- Communication ou affiche (champ `type`) : titre en italique. -->
          <if variable="genre">
            <text variable="title" font-style="italic"/>
          </if>
          <else>
            <text variable="title"/>
          </else>
        </choose>
      </else-if>
      <else-if type="patent">
        <!-- Le brevet n'a pas de titre : « Brevet canadien no CA 2633398 ». -->
        <group delimiter=" " font-style="italic">
          <text variable="title"/>
          <text variable="genre"/>
          <group delimiter="&#xA0;">
            <text term="issue" form="short"/>
            <text variable="number"/>
          </group>
        </group>
      </else-if>
      <else-if variable="title" match="none">
        <!-- Brevet ou document sans titre saisi en @misc : « Type no 123 ». -->
        <group delimiter=" " font-style="italic">
          <text variable="genre"/>
          <group delimiter="&#xA0;">
            <text term="issue" form="short"/>
            <text variable="issue"/>
          </group>
        </group>
      </else-if>
      <else>
        <text variable="title" font-style="italic"/>
      </else>
    </choose>
  </macro>

  <!-- Support d'un document non autonome. -->
  <macro name="container">
    <choose>
      <if type="chapter entry entry-dictionary entry-encyclopedia" match="any">
        <group delimiter=" ">
          <text term="in" text-case="capitalize-first"/>
          <group delimiter=", ">
            <text macro="editors-in"/>
            <text variable="container-title" font-style="italic"/>
          </group>
        </group>
      </if>
      <else-if type="paper-conference">
        <choose>
          <if variable="editor">
            <group delimiter=" ">
              <text term="in" text-case="capitalize-first"/>
              <group delimiter=", ">
                <text macro="editors-in"/>
                <text variable="container-title" font-style="italic"/>
              </group>
            </group>
          </if>
          <else>
            <text variable="container-title" font-style="italic"/>
          </else>
        </choose>
      </else-if>
      <else>
        <text variable="container-title" font-style="italic"/>
      </else>
    </choose>
  </macro>

  <!-- ====================== Édition, volume, pages ====================== -->

  <macro name="edition">
    <choose>
      <if is-numeric="edition">
        <group>
          <number variable="edition" form="ordinal"/>
          <text term="edition" form="short" prefix="&#xA0;"/>
        </group>
      </if>
      <else>
        <text variable="edition"/>
      </else>
    </choose>
  </macro>

  <macro name="pages">
    <group delimiter="&#xA0;">
      <label variable="page" form="short"/>
      <text variable="page"/>
    </group>
  </macro>

  <!-- « (3e éd., vol. 4, pp. 220-242) » — chapitres et ouvrages collectifs. -->
  <macro name="edition-volume-pages">
    <group prefix=" (" suffix=")" delimiter=", ">
      <text macro="edition"/>
      <group delimiter="&#xA0;">
        <text term="volume" form="short"/>
        <text variable="volume"/>
      </group>
      <group delimiter="&#xA0;">
        <text term="chapter" form="short"/>
        <text variable="number"/>
      </group>
      <text macro="pages"/>
    </group>
  </macro>

  <!-- « 7(3) » — volume en italique, fascicule entre parenthèses. -->
  <macro name="volume-issue">
    <group>
      <text variable="volume" font-style="italic"/>
      <text variable="issue" prefix="(" suffix=")"/>
    </group>
  </macro>

  <!-- ===================== Éditeur commercial et lieu ===================== -->

  <!-- L'organisme n'est repris comme éditeur que s'il n'a pas déjà servi
       d'auteur. -->
  <macro name="issuer">
    <choose>
      <if variable="publisher">
        <text variable="publisher"/>
      </if>
      <else-if variable="author editor" match="any">
        <text variable="authority"/>
      </else-if>
    </choose>
  </macro>

  <macro name="place-issuer">
    <group delimiter=": ">
      <text variable="publisher-place"/>
      <text macro="issuer"/>
    </group>
  </macro>

  <!-- ===================== Mentions propres aux types ===================== -->

  <!-- « (Mémoire de maîtrise, École de technologie supérieure, Montréal) ». -->
  <macro name="thesis-details">
    <group prefix="(" suffix=")" delimiter=", ">
      <text variable="genre"/>
      <text variable="authority"/>
      <text variable="publisher-place"/>
    </group>
  </macro>

  <!-- « (Rapport de recherche LPC no 157) ». -->
  <macro name="report-number">
    <group prefix=" (" suffix=")" delimiter="&#xA0;">
      <text variable="genre"/>
      <group delimiter="&#xA0;">
        <text term="issue" form="short"/>
        <text variable="number"/>
      </group>
    </group>
  </macro>

  <!-- Mention de format entre crochets : « [Logiciel] », « [Vidéo YouTube] ». -->
  <macro name="genre-bracket">
    <choose>
      <if variable="title">
        <text variable="genre" prefix=" [" suffix="]"/>
      </if>
    </choose>
  </macro>

  <!-- ============================== Accès ============================== -->

  <!-- Priorité au DOI, puis à l'URL, comme format.doi.or.url. -->
  <macro name="access">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix="doi:&#xA0;"/>
      </if>
      <else-if variable="URL">
        <group delimiter=" ">
          <text term="retrieved" text-case="capitalize-first"/>
          <group delimiter=" ">
            <text term="accessed"/>
            <date variable="accessed" form="numeric"/>
          </group>
          <text term="from"/>
          <text variable="URL"/>
        </group>
      </else-if>
    </choose>
  </macro>

  <!-- Thèses et mémoires : la note (base de données commerciale) prime sur
       l'URL, comme format.note.or.url. -->
  <macro name="access-thesis">
    <choose>
      <if variable="note">
        <group delimiter=" ">
          <text term="retrieved" text-case="capitalize-first"/>
          <text term="from"/>
          <text variable="note"/>
        </group>
      </if>
      <else>
        <text macro="access"/>
      </else>
    </choose>
  </macro>

  <!-- ============================ Citations ============================ -->

  <citation et-al-min="3" et-al-use-first="1"
            disambiguate-add-year-suffix="true"
            disambiguate-add-names="true"
            disambiguate-add-givenname="true"
            givenname-disambiguation-rule="primary-name"
            collapse="year">
    <sort>
      <key macro="author-sort"/>
      <key variable="issued"/>
    </sort>
    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=", ">
        <text macro="author-short"/>
        <text macro="year"/>
        <group delimiter="&#xA0;">
          <label variable="locator" form="short"/>
          <text variable="locator"/>
        </group>
      </group>
    </layout>
  </citation>

  <!-- ========================== Bibliographie ========================== -->

  <bibliography hanging-indent="true" entry-spacing="0" line-spacing="1">
    <sort>
      <key macro="author-sort"/>
      <key variable="issued"/>
      <key variable="title"/>
    </sort>
    <layout suffix=".">
      <group delimiter=". ">
        <text macro="author"/>
        <text macro="issued"/>

        <choose>
          <!-- [ Thèses et mémoires ] -->
          <if type="thesis">
            <group delimiter=". ">
              <text macro="title"/>
              <text macro="thesis-details"/>
              <text macro="access-thesis"/>
            </group>
          </if>

          <!-- [ Rapports techniques ] -->
          <else-if type="report">
            <group delimiter=". ">
              <group>
                <text macro="title"/>
                <text macro="report-number"/>
              </group>
              <text macro="place-issuer"/>
              <text variable="note"/>
              <text macro="access"/>
            </group>
          </else-if>

          <!-- [ Chapitres et entrées d'encyclopédie ] -->
          <else-if type="chapter entry entry-dictionary entry-encyclopedia" match="any">
            <group delimiter=". ">
              <text macro="title"/>
              <group>
                <text macro="container"/>
                <text macro="edition-volume-pages"/>
              </group>
              <text macro="place-issuer"/>
              <text macro="access"/>
            </group>
          </else-if>

          <!-- [ Articles de revue, de magazine, de quotidien ] -->
          <else-if type="article-journal article-magazine article-newspaper" match="any">
            <group delimiter=". ">
              <text macro="title"/>
              <group delimiter=", ">
                <text macro="container"/>
                <text macro="volume-issue"/>
                <text variable="page"/>
              </group>
              <text variable="note"/>
              <text macro="access"/>
            </group>
          </else-if>

          <!-- [ Communications et actes de conférence ] -->
          <else-if type="paper-conference">
            <choose>
              <!-- Communication, affiche ou présentation (champ `type`). -->
              <if variable="genre">
                <group delimiter=". ">
                  <text macro="title"/>
                  <group>
                    <group delimiter=", ">
                      <group delimiter=" ">
                        <text variable="genre"/>
                        <text term="presented at"/>
                        <text variable="container-title"/>
                      </group>
                      <text variable="publisher-place"/>
                    </group>
                    <text macro="pages" prefix=" (" suffix=")"/>
                  </group>
                  <text macro="access"/>
                </group>
              </if>
              <!-- Article publié dans des actes. -->
              <else>
                <group delimiter=". ">
                  <text macro="title"/>
                  <group delimiter=", ">
                    <text macro="container"/>
                    <text macro="volume-issue"/>
                    <choose>
                      <if variable="volume issue" match="any">
                        <text variable="page"/>
                      </if>
                      <else>
                        <text macro="pages"/>
                      </else>
                    </choose>
                  </group>
                  <text macro="place-issuer"/>
                  <text macro="access"/>
                </group>
              </else>
            </choose>
          </else-if>

          <!-- [ Brevets ] -->
          <else-if type="patent">
            <group delimiter=". ">
              <text macro="title"/>
              <group delimiter=": ">
                <text variable="publisher-place"/>
                <text variable="authority"/>
              </group>
              <text macro="access"/>
            </group>
          </else-if>

          <!-- [ Pages web, billets, vidéos, jeux de données ] -->
          <else-if type="webpage post post-weblog" match="any">
            <group delimiter=". ">
              <group>
                <text macro="title"/>
                <text macro="genre-bracket"/>
              </group>
              <text macro="place-issuer"/>
              <text macro="access"/>
            </group>
          </else-if>

          <!-- [ Documents inédits ] -->
          <else-if type="manuscript">
            <group delimiter=". ">
              <text macro="title"/>
              <group delimiter=", ">
                <text variable="genre"/>
                <text variable="authority"/>
                <text variable="publisher-place"/>
                <text variable="note"/>
              </group>
              <text macro="access"/>
            </group>
          </else-if>

          <!-- [ Livres ] -->
          <else-if type="book">
            <group delimiter=". ">
              <group>
                <text macro="title"/>
                <text macro="edition" prefix=" (" suffix=")"/>
              </group>
              <text variable="note"/>
              <text macro="place-issuer"/>
              <text macro="access"/>
            </group>
          </else-if>

          <!-- [ Normes, logiciels, notes de cours, divers ] -->
          <else>
            <group delimiter=". ">
              <group>
                <text macro="title"/>
                <text macro="edition" prefix=" (" suffix=")"/>
                <text macro="genre-bracket"/>
              </group>
              <text variable="note"/>
              <text macro="place-issuer"/>
              <text macro="access"/>
            </group>
          </else>
        </choose>
      </group>
    </layout>
  </bibliography>
</style>
