// catalogue.typ (farfadet-didactique) — défauts et contrôles des clés des environnements.
// FICHIER Fichier généré : ne pas le modifier à la main.

#import "../../socle/lib.typ": interne as _socle
#import _socle: reglages-controles as _c, reglages-choix as _choix, reglages-ou as _ou, bf-nommee as _nommee

/// Clés communes à tous les types (et leurs défauts).
#let _communs = (version: "toutes", rendu: "bf", rd: (:), skin: (:), before-skip: auto, after-skip: auto)

/// Contrôle de chaque clé : (test, description de ce qui est attendu).
#let _controles = (
  version: _choix("toutes", "prof", "eleve"),
  rendu: (v => type(v) in (str, function), "\"bf\", \"rd\", un skin intégré (\"cahier\", \"outil\", \"pastille\", \"manchette\", \"filet\", \"suspendu\", \"minimal\"), le nom d'un skin enregistré par setbfskins, ou une fonction d => contenu (par exemple bfskin(\"suspendu\", icone: \"cle\"))"),
  rd: (v => type(v) == dictionary, "un dictionnaire de clés de la boîte rd, par exemple (colframe: red)"),
  skin: (v => type(v) == dictionary, "un dictionnaire d'options du skin, par exemple (icone: \"cle\", epaisseur: 2pt)"),
  before-skip: _c.longueur,
  after-skip: _c.longueur,
  anki: _c.booleen,
  sommaire: _ou(_c.booleen, _c.contenu),
  numero: _c.booleen,
  numerotation: _choix("section", "globale"),
  compteur: _choix("par-type", "commun"),
  nameref: _c.contenu,
  couleur: _c.couleur-ou-nom,
  breakable: _c.booleen,
  craie: _c.booleen,
  icone: _ou(_c.contenu, _choix(none)),
  embleme: (v => v == auto or v == none or type(v) in (str, function, content), "auto, none, le nom d'une icône du jeu commun (\"coeur\", \"cle\"…), une fonction couleur => contenu ou un contenu"),
  variant: _choix("lignes", "minimal", "sidebar"),
  colback: _c.couleur-ou-nom,
  colframe: _c.couleur-ou-nom,
  colbacktitle: _c.couleur-ou-nom,
  banner-arc: _c.couleur-ou-nom,
  coltitle: _c.couleur-ou-nom,
  fonttitle: _ou(_choix("tiny", "scriptsize", "footnotesize", "small", "normalsize", "large", "Large", "LARGE", "huge", "Huge"), _c.longueur),
  arc: _c.longueur,
  edge-width: _c.longueur,
  left: _c.longueur,
  right: _c.longueur,
  top: _c.longueur,
  bottom: _c.longueur,
  boxsep: _c.longueur,
  drop-shadow: _c.booleen,
  title-xshift: _c.longueur,
  couleur-accent: _c.couleur-ou-nom,
  line-width: _c.longueur,
  corner-size: _c.longueur,
  barre: _choix("snake", "line", "none"),
  logo-size: _c.longueur,
  couleur-titre: _c.couleur-ou-nom,
  largeur-titre: _c.longueur,
  amplitude: _c.longueur,
  segment-length: _c.longueur,
  title-angle: (v => type(v) == angle, "un angle (-10deg)"),
  onglet: _c.contenu,
  boxrule: _c.longueur,
  width: _c.longueur,
  halign: _choix("left", "center", "right", "justify"),
)

