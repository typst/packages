// Slovar obveznih `min` in dovoljenih `max` števil sklopov `"P"` posameznega modula reference SI
// Poleg števil `min` in `max` je še niz `K` dolžine tri:
// * `"P"` podatek brez kontrolne številke
// * `"K"` podatek s kontrolno številko
// * `"S"` skupina podatkov s kontrolno številko na koncu
// * `"_"` podatka ni
// Posebnosti:
// * `SI00` nima kontrolne številke
// * `SI12` ima vedno n(P) + n(K) = 13, ne 12, in se po potrebi zapolni z vodilnimi ničlami
// * `SI99` nima podatkov
// Podvajanje je, ampak je sprejemljivo, ker je potem vsa koda v slovarju
#let modeli-si = (
	SI00: (K: "PPP", min: 1, max: 3),
	SI01: (K: "SSS", min: 1, max: 3),
	SI02: (K: "PKK", min: 3, max: 3),
	SI03: (K: "KKK", min: 3, max: 3),
	SI04: (K: "KPK", min: 3, max: 3),
	SI05: (K: "KPP", min: 1, max: 3),
	SI06: (K: "PSS", min: 2, max: 3),
	SI07: (K: "PKP", min: 2, max: 3),
	SI08: (K: "SSK", min: 3, max: 3),
	SI09: (K: "SSP", min: 1, max: 3),
	SI10: (K: "KSS", min: 2, max: 3),
	SI11: (K: "KKP", min: 2, max: 3),
	SI12: (K: "K__", min: 1, max: 1),
	// Ni 13-17
	SI18: (K: "KKP", min: 2, max: 3),
	SI19: (K: "KKP", min: 2, max: 3),
	// Ni 20
	SI21: (K: "KP_", min: 2, max: 2),
	SI22: (K: "KP_", min: 2, max: 2),
	SI23: (K: "KK_", min: 2, max: 2),
	// Ni 24-27
	SI28: (K: "KKP", min: 2, max: 3),
	// Ni 29-30
	SI31: (K: "KP_", min: 2, max: 2),
	SI32: (K: "KP_", min: 2, max: 2),
	// Ni 33-37
	SI38: (K: "KKP", min: 2, max: 3),
	// Ni 39
	SI40: (K: "KKP", min: 2, max: 3),
	SI41: (K: "KKP", min: 2, max: 3),
	// Ni 42-47
	SI48: (K: "KKP", min: 2, max: 3),
	SI49: (K: "KKP", min: 2, max: 3),
	// Ni 50
	SI51: (K: "KKP", min: 2, max: 3),
	// Ni 52-54
	SI55: (K: "KPP", min: 1, max: 3),
	SI58: (K: "KKP", min: 2, max: 3),
	// Ni 59-98
	SI99: (K: "___", min: 0, max: 0),
)

