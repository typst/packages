#let kamuflaža(
	gostota: "sreda",
	polnilo: black,
) = tiling(
	size: (1cm, 11mm), {
		if gostota not in gostote.keys() {
			panic("Neznana kamuflažna gostota '" + repr(gostota) + "' namesto pričakovane '" + gostote.keys().join("' , '", last: "' ali '") + "'")
		}

		if type(polnilo) not in (type(none), color, gradient, tiling) {
			panic("Neznano polnilo `" + repr(polnilo) + "`")
		}

		let pts = gostote.at(gostota)

		for (x, y) in pts {
			place(
				dx: x * 1pt,
				dy: y * 1pt,
				circle(
					fill: polnilo,
					radius: 1pt,
				),
			)
		}
})