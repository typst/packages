@article{agahiModifiedKullbackLeibler2019,
  title = {A Modified Kullback--Leibler Divergence for Non-Additive Measures Based on Choquet Integral},
  author = {Agahi, Hamzeh},
  year = 2019,
  month = jul,
  journal = {Fuzzy Sets and Systems},
  series = {Theme: {{Uncertainty Management}}},
  volume = {367},
  pages = {107--117},
  issn = {0165-0114},
  urldate = {2026-06-18},
  abstract = {The Kullback--Leibler divergence is a very important concept in statistics and probability which helps us in many problems of information systems. The main property of the Kullback--Leibler divergence is non-negativity. The study of Kullback--Leibler divergence for Choquet integral has been led to a challenging problem. Torra (2017) [1] introduced the definition of the Kullback--Leibler divergence for two non-additive measures, including Choquet integral and derivative with respect to non-additive measures. This paper focuses on the non-negativity of Kullback--Leibler divergence for two non-additive measures and shows that it is not always non-negative in general. This reason permits us to introduce new versions of Kullback--Leibler divergence and f-divergence for Choquet integral which are always non-negative. We also focus on the lower bounds of f-divergence for non-additive measures and improve some previous results appearing in the literature.},
  langid = {english},
  keywords = {-divergence,Choquet integral,Kullback-Leibler divergence,Non-additive measures},
  file = {C\:\\Users\\xialugui\\Zotero\\storage\\VD7K3UC3\\j.fss.2019.01.021.pdf.pdf;C\:\\Users\\xialugui\\Zotero\\storage\\WE7ZXAL5\\S0165011419301150.html}
}

@article{altaheriDeepLearningTechniques2023b,
  title = {Deep Learning Techniques for Classification of Electroencephalogram ({{EEG}}) Motor Imagery ({{MI}}) Signals: {{A}} Review},
  shorttitle = {Deep Learning Techniques for Classification of Electroencephalogram ({{EEG}}) Motor Imagery ({{MI}}) Signals},
  author = {Altaheri, Hamdi and Muhammad, Ghulam and Alsulaiman, Mansour and Amin, Syed Umar and Altuwaijri, Ghadir Ali and Abdul, Wadood and Bencherif, Mohamed A. and Faisal, Mohammed},
  year = 2023,
  month = jul,
  journal = {Neural Computing and Applications},
  volume = {35},
  number = {20},
  pages = {14681--14722},
  issn = {1433-3058},
  urldate = {2025-04-17},
  abstract = {The brain--computer interface (BCI) is an emerging technology that has the potential to revolutionize the world, with numerous applications ranging from healthcare to human augmentation. Electroencephalogram (EEG) motor imagery (MI) is among the most common BCI paradigms that have been used extensively in smart healthcare applications such as post-stroke rehabilitation and mobile assistive robots. In recent years, the contribution of deep learning (DL) has had a phenomenal impact on MI-EEG-based BCI. In this work, we systematically review the DL-based research for MI-EEG classification from the past ten years. This article first explains the procedure for selecting the studies and then gives an overview of BCI, EEG, and MI systems. The DL-based techniques applied in MI classification are then analyzed and discussed from four main perspectives: preprocessing, input formulation, deep learning architecture, and performance evaluation. In the discussion section, three major questions about DL-based MI classification are addressed: (1) Is preprocessing required for DL-based techniques? (2) What input formulations are best for DL-based techniques? (3) What are the current trends in DL-based techniques? Moreover, this work summarizes MI-EEG-based applications, extensively explores public MI-EEG datasets, and gives an overall visualization of the performance attained for each dataset based on the reviewed articles. Finally, current challenges and future directions are discussed.},
  langid = {english},
  keywords = {Artificial Intelligence,Brain-computer interface (BCI),Classification,Deep learning,Electroencephalogram (EEG),Motor imagery (MI),Survey},
  annotation = {TLDR: This work systematically review the DL-based research for MI-EEG classification from the past ten years, summarizes MI- EEG-based applications, extensively explores public MI-eeG datasets, and gives an overall visualization of the performance attained for each dataset based on the reviewed articles.},
  file = {C:\Users\xialugui\Zotero\storage\MMRXX7L7\Altaheri 等 - 2023 - Deep learning techniques for classification of electroencephalogram (EEG) motor imagery (MI) signals.pdf}
}

@article{alwasitiMotorImageryClassification2020,
  title = {Motor Imagery Classification for Brain Computer Interface Using Deep Metric Learning},
  author = {Alwasiti, Haider and Yusoff, Mohd Zuki and Raza, Kamran},
  year = 2020,
  journal = {IEEE Access},
  volume = {8},
  pages = {109949--109963},
  issn = {2169-3536},
  urldate = {2025-04-13},
  abstract = {Deep metric learning (DML) has achieved state-of-the-art results in several deep learning applications. However, this type of deep learning models has not been tested on the classification of electrical brain waves (EEG) for brain computer interface (BCI) applications. For the first time, we propose a triplet network to classify motor imagery (MI) EEG signals. Stockwell Transform has been used for converting the EEG signals in the time domain into the frequency domain, which resulted in improved DML classification accuracy in comparison to DML with Short Term Fourier Transform (0.647 vs. 0.431). DML model was trained with a topogram of concatenated 64 EEG channel spectrograms. The training batch was comprised of triplet pairs of the anchor, positive, and negative labeled epochs. The triplet network was able to train an embedding feature space that minimized the Euclidean distance between the embeddings of spectrograms of the same class and increased the distance between the embeddings of different labeled images. The proposed method has been tested on an EEG dataset of 109 untrained subjects. We showed that the DML classifier is able to converge with an extremely small number of training samples ( 120 EEG trials) for only one subject per model, mitigating the well-known issue of the large inter-individual variability of human MI-BCI EEG which degrades the classification performance. The proposed preprocessing pipeline and the Triplet Network provide a promising method to classify MI-BCI EEG signals with much less training samples than the previous methods.},
  keywords = {BCI,Brain modeling,Data models,Deep learning,EEG,Electroencephalography,Feature extraction,metric learning,Stockwell transform,Training},
  annotation = {TLDR: The DML classifier is able to converge with an extremely small number of training samples for only one subject per model, mitigating the well-known issue of the large inter-individual variability of human MI-BCI EEG which degrades the classification performance.},
  file = {C\:\\Users\\xialugui\\Zotero\\storage\\326PAAVF\\Alwasiti 等 - 2020 - Motor Imagery Classification for Brain Computer Interface Using Deep Metric Learning.pdf;C\:\\Users\\xialugui\\Zotero\\storage\\XJSUX98A\\9116935.html}
}
