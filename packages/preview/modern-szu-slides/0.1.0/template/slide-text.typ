#import "libs/szu-colors.typ": *

// Font families.
#let zh-font = "Heiti SC"
#let en-font = "Times New Roman"

// Color palette.
#let cover-bg = szu-first-red
#let cover-paper = rgb("#fbf9f6")
#let cover-accent = cover-bg
#let cover-institution = white
#let cover-rule = rgb("#cebeb3")
#let outline-rule = szu-third-red
#let strong-text-fill = black

#let card-fill = rgb("#f8f3f0")
#let card-stroke = rgb("#d8c6bf")
#let conclusion-fill = rgb("#faf6f3")
#let note-fill = rgb("#fbf7f5")
#let note-text-fill = rgb("#6f5a55")

// Title page text sizes.
#let cover-title-size = 2.0em
#let cover-meta-label-size = 1em
#let cover-meta-value-size = 0.95em
#let cover-person-label-size = 1.08em
#let cover-person-value-size = 1.08em
#let cover-date-size = 1em

// Outline page text sizes.
#let outline-heading-size = 1.5em
#let outline-number-size = 1.0em
#let outline-item-title-size = 1.35em
#let outline-item-body-size = 1.0em
#let outline-item-height = 1.55em

// Slide body and heading sizes.
#let body-text-size = 1em
#let work-body-text-size = 16pt
#let small-title-size = 22pt
#let section-title-size = 40pt

// Reusable content block text sizes.
#let card-title-size = 10pt
#let card-text-size = 13pt
#let metric-label-size = 13pt
#let metric-value-size = 22pt
#let metric-note-size = 12pt
#let issue-tag-size = 15.5pt
#let issue-desc-size = 15pt
#let conclusion-label-size = 16pt
#let conclusion-card-title-size = 15pt
#let route-card-title-size = 18pt
#let conclusion-text-size = 15.5pt

// Figure, table, and reference text sizes.
#let figure-caption-size = 10pt
#let large-figure-caption-size = 15pt
#let table-caption-size = 14pt
#let table-text-size = 13pt
#let bibliography-text-size = 10pt
#let appendix-reference-size = 11pt

// Thanks page text sizes.
#let thanks-primary-size = 40pt
#let thanks-secondary-size = 30pt
#let thanks-primary-fill = rgb("#8d1f1f")
