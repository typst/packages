// Common abbreviations and symbols — the LaTeX template's \ie, \eg, \tick etc.
// Add your own recurring terms here (the \myTerm pattern): define once, use
// everywhere, prevent typos.

#let ie = "i.e."
#let eg = "e.g."
#let etal = "et al."
#let etc- = "etc."
#let cf = "cf."
#let vs = "vs."

#let tick = text(fill: rgb(0, 128, 0), "\u{2713}")
#let cross = text(fill: rgb(128, 0, 0), "\u{2717}")
#let soso = text(fill: orange, "\u{25A1}")

// Example recurring term — replace with your own:
#let my-term = "myTerm"
