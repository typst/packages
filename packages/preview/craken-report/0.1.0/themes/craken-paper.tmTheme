<plist version="1.0"><dict><key>name</key><string>Captain Craken Paper</string><key>settings</key><array>
<dict><key>settings</key><dict><key>background</key><string>#f4eadc</string><key>foreground</key><string>#2e221b</string></dict></dict>
<dict><key>name</key><string>Keywords</string><key>scope</key><string>keyword, storage, storage.type, support.function.builtin, support.type, constant.language.python, variable.language, entity.name.function.decorator, meta.decorator, punctuation.definition.decorator</string><key>settings</key><dict><key>foreground</key><string>#a63f29</string></dict></dict>
