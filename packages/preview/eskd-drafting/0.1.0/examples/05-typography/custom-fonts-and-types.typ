#import "@preview/eskd-drafting:0.1.0": *

// Пример: Пользовательские шрифты (Font Injection) и начертания по ГОСТ 2.304-81
// Демонстрирует:
// 1. Внедрение пользовательской гарнитуры через параметр `font`;
// 2. Переключение начертания на Шрифт типа А (`font-type: "type-a"`);
// 3. Многостраничный переход с первого листа (Форма 2) на последующий (Форма 2а);
// 4. Включение аутентичного наклонного начертания 75° через `font-italic: true`.

#show: eskd-document.with(
  paper: "a4",                                 // Формат листа А4
  orientation: "portrait",                     // Вертикальная ориентация
  font: ("OpenGost Type A TT", "PT Astra Sans", "Arial"), // Список пользовательских шрифтов (Font Injection)
  font-type: "type-a",                         // Начертание шрифта типа А по ГОСТ 2.304-81 (d = 1/14 h)
  font-italic: true,                           // Аутентичный наклон 75° (без искусственного скоса)
  preset-lines: "gost",                        // Буквальный ГОСТ-пресет: тонкие разделители 0.35 мм

  // Графы 10–13: Подписи участников (5 строк для Формы 2)
  members: (
    ("Разраб.", "Иванов И.И.",  "01.09.26"),
    ("Пров.",   "Петров П.П.",  "03.09.26"),
    ("Т.контр.","Сидоров С.С.", "04.09.26"),
    ("Н.контр.","Кузнецов К.К.","05.09.26"),
    ("Утв.",    "Смирнов С.С.", "06.09.26"),
  ),

  // Основные графы руководства по эксплуатации:
  code: [МГТУ.752100.001РЭ],                   // Графа 2: Обозначение руководства
  name: [Вал ступенчатый\ Руководство по изготовлению], // Графа 1: Наименование
  org: [Кафедра РК-1],                         // Графа 9: Организация
  lit: [У],                                    // Графа 4: Учебная литера
  inv-orig: [УЧ-2026],                         // Графа 19: Инвентарный номер подлинника
  sig-date-orig: [01.09.26],                   // Графа 20: Подпись и дата
  inv-repl: [ВЗ-0012],                         // Графа 21: Взамен инв. №
)

// Лист 1: Заглавный лист (Форма 2 40 мм, Шрифт типа А)
#show: page-first-form2

= 1. Особенности чертежного шрифта типа А (ГОСТ 2.304-81)
Шрифт типа А характеризуется более тонкими линиями обводки знаков ($d = 1/14 h$) по сравнению со шрифтом типа Б ($d = 1/10 h$). Это обеспечивает высокую четкость при нанесении плотных размерных сеток и мелких условных обозначений на чертежах и схемах высокой насыщенности.

Основные размерные пропорции шрифта типа А приведены ниже:
- толщина линии шрифта: $d = (1/14) h$;
- ширина прописных букв нормального начертания: $g = (6/14) h$;
- минимальный шаг строк (интерлиньяж): $b = (20/14) h approx 1.429 h$;
- расстояние между соседними буквами: $a = (2/14) h approx 0.143 h$;
- минимальное расстояние между словами: $e = (6/14) h approx 0.429 h$.

= 2. Внедрение гарнитуры пользователя (Font Injection)
Механизм внедрения шрифтов пакета `eskd-drafting` автоматически масштабирует кегль и вычисляет межбуквенный трекинг пользовательского шрифта, обеспечивая визуальное соответствие геометрическим канонам ГОСТ 2.304-81.

