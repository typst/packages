#import "@preview/eskd-drafting:0.1.0": *

// Пример: Сборочный чертеж (Формат А2 вертикальный, штамп Форма 1, боковик 7r с фиксированным разрывом 47 мм)
// Демонстрирует:
// - Компоновку бокового штампа 7r с разрывом gap: 47mm для удобной фальцовки и подшивки в папку формата А4

#show: eskd-document.with(
  paper: "a2",                                 // Формат листа А2 (420х594 мм)
  orientation: "portrait",                     // Портретная (вертикальная) ориентация листа
  preset-lines: "industry",                    // САПР-пресет толщин линий (0.8 мм разделители)

  // Графы 10–13: Подписи исполнителей (до 6 строк в Форме 1)
  members: (
    ("Разраб.", "Алексеев А.А.",  "20.05.26"),
    ("Пров.",   "Борисов Б.Б.",   "22.05.26"),
    ("Т.контр.","Васильев В.В.",  "23.05.26"),
    (), // Пустая строка-разделитель
    ("Н.контр.","Григорьев Г.Г.", "24.05.26"),
    ("Утв.",    "Дмитриев Д.Д.",  "25.05.26"),
  ),

  // Основные графы штампа Формы 1 по ГОСТ 2.104-2006:
  code-inverted: auto,                         // Графа 26: Повернутое на 180° обозначение в углу листа
  code: [АБВГ.401100.001СБ],                   // Графа 2: Обозначение сборочного чертежа
  name: [Чайник заварочный\ Сборочный чертеж], // Графа 1: Наименование изделия и вида документа
  org: [Опытно-конструкторское бюро],          // Графа 9: Предприятие-разработчик
  lit: [О1],                                   // Графа 4: Литера документа (О1 — опытный образец)
  mass: [0,85],                                // Графа 5: Масса изделия в кг (число с запятой)
  scale: [1:1],                                // Графа 6: Масштаб чертежа

  // Боковые штампы инвентарного учета (графы 19–20, 24–25):
  inv-orig: [67121],                           // Графа 19: Инвентарный номер подлинника
  sig-date-orig: [20.05.26],                   // Графа 20: Подпись и дата приемки подлинника
  ref-num: [ЧАЙ.2026],                         // Графа 24: Справочный номер
  prim-apply: [АБВГ.401100.000],               // Графа 25: Первичное применение

  format: true,                                // Графа 32: Отображение надписи Формат А2
)

// Боковой штамп 7r с фиксированным разрывом 47 мм:
// графы 24 («Справ. №») и 25 («Перв. примен.») располагаются в пределах первых 287 мм от низа листа,
// что обеспечивает их видимость на первом сгибе при фальцовке в формат А4 для подшивки в папку/скоросшиватель.
#show: page-first-form1.with(left: frame-left-7r)

#align(center + horizon)[
  #rect(width: 350mm, height: 480mm, stroke: 0.5mm)[
    #align(center + horizon)[
      #gost-text(h: h10_0, weight: "bold")[Сборочный чертеж емкости для заваривания]\
      #v(8mm)
      #gost-text(h: h5_0)[(Формат А2, вертикальный, 420 #sym.times 594~мм, штамп Форма 1 по ГОСТ~2.104-2006)]\
      #v(4mm)
      #gost-text(h: h3_5)[1 — Корпус; 2 — Крышка с пароотводом; 3 — Фильтрующий элемент; 4 — Ручка]\
      #v(4mm)
      #gost-text(h: h2_5)[Боковой штамп 7r скомпонован с gap: 47mm для подшивки в скоросшиватель А4]
    ]
  ]
]