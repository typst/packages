#import "@preview/eskd-drafting:0.1.0": *

// Пример: Чертеж и функциональная схема на кратном формате А4х3 (ГОСТ 2.301-68)
// Демонстрирует:
// 1. Применение дополнительного (кратного) формата листа А4х3 (630 x 297 мм);
// 2. Построение внешней рабочей рамки: рабочая ширина (210 * 3 - 25) = 605 мм, рабочая высота 287 мм;
// 3. Автоматическое заполнение Графы 32 под штампом Формы 1 значением «Формат А4х3»;
// 4. Размещение бокового штампа 7r (frame-left-7r) на поле подшивки 20 мм;
// 5. Графу 26 с повернутым обозначением чертежа в левом верхнем углу (70х14 мм).

#show: eskd-document.with(
  paper: "a4x3",                                // Формат А4х3 (630х297 мм) по ГОСТ 2.301-68
  code: [АБВГ.466453.012Э3],                    // Графа 2: Обозначение документа (Схема электрическая принципиальная)
  name: [Линия автоматической сортировки\ Схема функциональная], // Графа 1: Наименование
  org: [АО «Приборостроение»],                  // Графа 9: Предприятие / организация
  lit: [О1],                                    // Графа 4: Литера
  mass: none,                                   // Графа 5: Масса (для схем не указывается)
  scale: none,                                  // Графа 6: Масштаб (для схем не указывается)
  members: (
    ("Разраб.", "Иванов И.И.",  "12.06.26"),
    ("Пров.",   "Петров П.П.",  "14.06.26"),
    ("Т.контр.","Васильев В.В.","15.06.26"),
    ("Н.контр.","Кузнецов К.К.","16.06.26"),
    ("Утв.",    "Смирнов С.С.", "17.06.26"),
  ),
  copier: [Федоров],                            // Графа 31: Фамилия копировщика
  format: auto,                                 // Графа 32: Обозначение формата (авто -> «Формат А4х3»)
)

// Оформление заглавного листа чертежа (Форма 1, боковой штамп 7r)
#show: page-first-form1.with(left: frame-left-7r)

// Содержимое схемы на широком поле формата А4х3 (рабочая зона 605 x 287 мм)
#v(5mm)
#align(center)[
  #gost-text(h: h7_0, weight: "bold")[ФУНКЦИОНАЛЬНАЯ СХЕМА ТЕХНОЛОГИЧЕСКОЙ ЛИНИИ]\
  #v(2mm)
  #gost-text(h: h3_5)[Габарит разворота: $630 times 297 "мм"$ (рабочее поле рамки: $605 times 287 "мм"$, фальцовка по ГОСТ 2.501-2013)]
]

#v(8mm)

// Блок-схема технологического тракта
#grid(
  columns: (100mm, 20mm, 100mm, 20mm, 100mm, 20mm, 100mm),
  align: center + horizon,
  rect(width: 100mm, height: 60mm, stroke: 0.8mm)[
    #align(center + horizon)[
      #gost-text(h: h5_0, weight: "bold")[МОДУЛЬ ПОДАЧИ]\
      #v(2mm)
      #gost-text(h: h2_5)[Загрузочный бункер\ Вибропитатель ВП-1\ Датчик наличия сырья]
    ]
  ],
  [#gost-text(h: h5_0)[$arrow.r$]],
  rect(width: 100mm, height: 60mm, stroke: 0.8mm)[
    #align(center + horizon)[
      #gost-text(h: h5_0, weight: "bold")[ОПТИЧЕСКИЙ АНАЛИЗ]\
      #v(2mm)
      #gost-text(h: h2_5)[Высокоскоростная камера\ Спектральный осветитель\ Блок ЦОС ТС-400]
    ]
  ],
  [#gost-text(h: h5_0)[$arrow.r$]],
  rect(width: 100mm, height: 60mm, stroke: 0.8mm)[
    #align(center + horizon)[
      #gost-text(h: h5_0, weight: "bold")[ПНЕВМОСЕПАРАТОР]\
      #v(2mm)
      #gost-text(h: h2_5)[Матрица форсунок (64 шт.)\ Ресивер 0.8 МПа\ Блок электроклапанов]
    ]
  ],
  [#gost-text(h: h5_0)[$arrow.r$]],
  rect(width: 100mm, height: 60mm, stroke: 0.8mm)[
    #align(center + horizon)[
      #gost-text(h: h5_0, weight: "bold")[НАКОПИТЕЛЬ]\
      #v(2mm)
      #gost-text(h: h2_5)[Лотки кондиционной продукции\ Бункер отбраковки\ Весовой терминал]
    ]
  ],
)

#v(10mm)

#align(left)[
  #block(width: 380mm)[
    #gost-text(h: h3_5, weight: "bold")[1. Технические требования и параметры оформления:]\
    #gost-text(h: h2_5)[
      1.1. Лист формата А4х3 ($630 times 297 "мм"$) складывается по ГОСТ 2.501-2013 в габарит А4 ($210 times 297 "мм"$) за два вертикальных сгиба.\
      1.2. Поле подшивки 20 мм расположено только у крайнего левого края первого сегмента листа.\
      1.3. Основная надпись (Форма 1) и графы 31 («Копировал Федоров») и 32 («Формат А4х3») размещены в правом нижнем углу листа.
    ]
  ]
]
