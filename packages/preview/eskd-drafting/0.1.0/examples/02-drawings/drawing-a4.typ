#import "@preview/eskd-drafting:0.1.0": *

// Пример: Рабочий чертеж детали (Формат А4 вертикальный, штамп Форма 1, боковик 3r)
// Демонстрирует:
// 1. Вертикальный чертеж формата А4 со штампом Форма 1 (55 мм) по ГОСТ 2.104-2006;
// 2. Трехстрочный боковой штамп инвентарного учета (боковик 3r, графы 19–23);
// 3. Автоматическое повернутое обозначение документа в Графе 26 (code-inverted: auto);
// 4. Заполнение графы 3 («Материал») и учебной литеры «У».

#show: eskd-document.with(
  paper: "a4",                                // Формат листа по ГОСТ 2.301-68
  orientation: "portrait",                    // Ориентация листа (для А4 допускается только книжная)
  preset-lines: "industry",                   // САПР-пресет: основные разделители ячеек толщиной 0.8 мм

  // Графы 10–13: Подписи исполнителей (до 6 строк в Форме 1 по ГОСТ 2.104-2006)
  members: (
    ("Разраб.", "Иванов И.И.", "12.05.26"),
    ("Пров.",   "Петров П.П.", "14.05.26"),
    ("Т.контр.","Сидоров С.С.","15.05.26"),
    (), // Пустая строка-разделитель (пропуск)
    ("Н.контр.","Кузнецов К.К.","16.05.26"),
    ("Утв.",    "Смирнов С.С.","18.05.26"),
  ),

  // Основные графы штампа Формы 1 по ГОСТ 2.104-2006:
  code: [АБВГ.715141.001],                    // Графа 2: Обозначение документа (120х15 мм)
  name: [Вал ступенчатый],                    // Графа 1: Наименование детали (70х25 мм)
  org: [МГТУ им. Н.Э. Баумана\ Кафедра РК-1], // Графа 9: Предприятие / организация (50х15 мм)
  material: [Сталь 45 ГОСТ 1050-2013],        // Графа 3: Обозначение материала детали (70х15 мм)
  lit: [У],                                   // Графа 4: Литера по ГОСТ 2.103-2013 ("У" — учебная)
  mass: [2,45],                               // Графа 5: Масса изделия в кг (число с десятичной запятой)
  scale: [1:1],                               // Графа 6: Масштаб чертежа по ГОСТ 2.302-68

  // Боковые штампы инвентарного учета на поле подшивки 20 мм (графы 19–21):
  inv-orig: [84120],                          // Графа 19: Инвентарный номер подлинника
  sig-date-orig: [12.05.26],                  // Графа 20: Подпись и дата приемки подлинника
  inv-repl: [ВЗ-4512],                        // Графа 21: Взамен инвентарного номера
)

// Вызов чертежной страницы со штампом Формы 1 и боковым штампом 3r (85х12 мм)
#show: eskd-page.with(
  bottom: frame-form-1,
  left: frame-left-3r,
  frame: true,
)

#align(center + horizon)[
  #rect(width: 140mm, height: 160mm, stroke: 0.5mm)[
    #align(center + horizon)[
      #gost-text(h: h7_0, weight: "bold")[ЗОНА ГРАФИЧЕСКОГО ПОЛЯ ЧЕРТЕЖА]\
      #v(6mm)
      #gost-text(h: h5_0)[(Формат А4 вертикальный, 210 #sym.times 297~мм)]\
      #v(4mm)
      #gost-text(h: h3_5)[Штамп Форма 1 (185 #sym.times 55~мм), боковой штамп 3r (85 #sym.times 12~мм), Графа 26]
    ]
  ]
]