#import "@preview/eskd-drafting:0.1.0": *

// Пример: Таблица изменений (графы 14-18 ГОСТ 2.104-2006, ГОСТ 2.503-2013)
// Демонстрирует:
// 1. Задание записей об изменениях через единый строгий параметр `changes` (массив словарей);
// 2. Многострочное отображение изменений в штампе чертежа (Форма 1);
// 3. Динамическое обновление актуальной строки изменения на последующих листах (Форма 2а) через `eskd-set`.

#show: eskd-document.with(
  paper: "a4",                                 // Формат листа А4
  orientation: "portrait",                     // Вертикальная ориентация
  preset-lines: "industry",                    // САПР-пресет толщин линий (0.8 мм)

  // Таблица изменений (графы 14–18 по ГОСТ 2.104-2006 и ГОСТ 2.503-2013):
  changes: (
    (
      num: [1],                                // Графа 14: Номер изменения (Изм.)
      sheet: [Зам.],                           // Графа 15: Номер листа (Лист: Зам., Нов., или номер)
      doc: [ИИ.102-2026],                      // Графа 16: Обозначение извещения об изменении (№ докум.)
      sig: [Иван.],                            // Графа 17: Подпись лица, внесшего изменение (Подп.)
      date: [01.09.26],                        // Графа 18: Дата внесения изменения (Дата)
    ),
    (
      num: [2],
      sheet: [Нов.],
      doc: [ИИ.145-2026],
      sig: [Иван.],
      date: [15.10.26],
    ),
  ),

  // Графы 10–13: Подписи участников (5 строк)
  members: (
    ("Разраб.", "Иванов И.И.",  "01.06.26"),
    ("Пров.",   "Петров П.П.",  "03.06.26"),
    ("Т.контр.","Васильев В.В.","04.06.26"),
    ("Н.контр.","Кузнецов К.К.","05.06.26"),
    ("Утв.",    "Смирнов С.С.", "06.06.26"),
  ),

  // Основные графы штампа по ГОСТ 2.104-2006:
  code: [АБВГ.123456.001],                     // Графа 2: Обозначение чертежа
  name: [Блок питания импульсный\ Сборочный чертеж], // Графа 1: Наименование
  org: [НПК «Энергия»],                        // Графа 9: Организация
  lit: [О1],                                   // Графа 4: Литера
  mass: [1,20],                                // Графа 5: Масса в кг
  scale: [1:1],                                // Графа 6: Масштаб
)

// Лист 1: Сборочный чертеж с таблицей изменений (Форма 1)
#show: page-first-form1

#align(center + horizon)[
  #rect(width: 155mm, height: 160mm, stroke: 0.8mm)[
    #align(center + horizon)[
      #gost-text(h: h7_0, weight: "bold")[БЛОК ПИТАНИЯ ИМПУЛЬСНЫЙ]\
      #v(8mm)
      #rect(width: 100mm, height: 60mm, stroke: 0.5mm)[
        #align(center + horizon)[#gost-text(h: h3_5)[Габаритный контур корпуса 220В / 24В]]
      ]
      #v(6mm)
      #gost-text(h: h3_5)[Лист 1 изменен по Извещению об изменении ИИ.102-2026 (Зам. листа)]
    ]
  ]
]

// Лист 2: Спецификация изменений (Форма 2а)
// Фиксируем актуальное изменение (Изм. 2) для листа 2 через eskd-set
#eskd-set(changes: ((num: [2], sheet: [Нов.], doc: [ИИ.145-2026], sig: [Иван.], date: [15.10.26]),))
#show: page-body

= 1. Лист регистрации изменений по ГОСТ 2.503-2013
Внесение изменений в комплект конструкторской документации АБВГ.123456.001 выполнено на основании извещения об изменении ИИ.102-2026.

#table(
  columns: (25mm, 35mm, 35mm, 35mm, 25mm),
  align: (center, center, center, center, center),
  [Изм.], [Номера листов], [Основание], [Подпись], [Дата],
  [1], [1 (Зам.)], [ИИ.102-2026], [Иванов], [01.09.26],
  [1], [2 (Нов.)], [ИИ.102-2026], [Иванов], [01.09.26]
)

= 2. Содержание изменения
Замена транзистора силового ключа $V T 1$ на компонент с повышенным рабочим напряжением $V_text("BR") = 650 "В"$ для обеспечения надежности при импульсных перенапряжениях питающей сети.
