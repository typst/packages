#import "@preview/eskd-drafting:0.1.0": *

// Пример: Продвинутая настройка таблицы изменений (графы 14-18 ГОСТ 2.104-2006, ГОСТ 2.503-2013)
// Демонстрирует:
// 1. Многострочную таблицу изменений в штампе чертежа (до 4 строк в Форме 1)
// 2. Строгий формат массива словарей (array of dict)
// 3. Индивидуальную настройку высот шрифтов ячеек (doc-size, sig-size, size)
// 4. Автоматическую гармонизацию кеглей в столбцах таблицы изменений (compute-group-font)
// 5. Динамическое обновление актуального изменения на последующих листах через eskd-set

#show: eskd-document.with(
  paper: "a4",                                 // Формат листа А4
  orientation: "portrait",                     // Вертикальная ориентация
  preset-lines: "industry",                    // САПР-пресет толщин линий (0.8 мм)

  // Таблица изменений (графы 14–18 по ГОСТ 2.104-2006 и ГОСТ 2.503-2013)
  changes: (
    // Запись 1: Базовое изменение
    (
      num: [1],
      sheet: [Зам.],
      doc: [ИИ.102-2026],
      sig: [Иванов],
      date: [01.09.26],
    ),
    // Запись 2: Словарь с индивидуальной настройкой кегля длинного номера извещения (doc-size)
    (
      num: [2],
      sheet: [Нов.],
      doc: [ИИ.145-2026-СПЕЦ],
      sig: [Петров],
      date: [15.10.26],
      doc-size: h2_5,                          // Точечный кегль для длинного шифра извещения
    ),
    // Запись 3: Очередное изменение
    (
      num: [3],
      sheet: [Зам.],
      doc: [ИИ.201-2026],
      sig: [Сидоров],
      date: [20.11.26],
    ),
  ),

  // Графы 10–13: Подписи участников (до 6 строк для Формы 1)
  members: (
    ("Разраб.", "Иванов И.И.",  "01.06.26"),
    ("Пров.",   "Петров П.П.",  "03.06.26"),
    ("Т.контр.","Васильев В.В.","04.06.26"),
    (),
    ("Н.контр.","Кузнецов К.К.","05.06.26"),
    ("Утв.",    "Смирнов С.С.", "06.06.26"),
  ),

  // Основные графы штампа по ГОСТ 2.104-2006:
  code: [АБВГ.468152.001СБ],                   // Графа 2: Обозначение сборочного чертежа
  name: [Блок процессорный\ Сборочный чертеж], // Графа 1: Наименование
  org: [НПК «Электроника»],                    // Графа 9: Организация
  lit: [О1],                                   // Графа 4: Литера
  mass: [1,85],                                // Графа 5: Масса в кг
  scale: [1:1],                                // Графа 6: Масштаб
)

// Лист 1: Сборочный чертеж (Форма 1 55 мм, до 4 строк изменений)
#show: page-first-form1

#align(center + horizon)[
  #rect(width: 155mm, height: 160mm, stroke: 0.8mm)[
    #align(center + horizon)[
      #gost-text(h: h7_0, weight: "bold")[БЛОК ПРОЦЕССОРНЫЙ]\
      #v(8mm)
      #rect(width: 110mm, height: 60mm, stroke: 0.5mm)[
        #align(center + horizon)[#gost-text(h: h3_5)[Габаритный чертеж модуля процессора]]
      ]
      #v(6mm)
      #gost-text(h: h3_5)[В штампе отображены 3 записи об изменениях (Изм. 1..3)]
    ]
  ]
]

// Лист 2: Спецификация изменений (Форма 2а 15 мм, 1 строка изменения)
// На последующих листах фиксируем актуальное (последнее) изменение через #eskd-set
#eskd-set(changes: ((num: [3], sheet: [Зам.], doc: [ИИ.201-2026], sig: [Сидоров], date: [20.11.26]),))
#show: page-body

= 1. Лист регистрации изменений по ГОСТ 2.503-2013
Внесение изменений в комплект конструкторской документации АБВГ.468152.001 выполнено в соответствии с извещениями об изменениях:

#table(
  columns: (20mm, 30mm, 40mm, 35mm, 25mm),
  align: (center, center, center, center, center),
  [Изм.], [Номера листов], [Основание (№ докум.)], [Подпись], [Дата],
  [1], [1 (Зам.)], [ИИ.102-2026], [Иванов], [01.09.26],
  [2], [1 (Нов.)], [ИИ.145-2026-СПЕЦ], [Петров], [15.10.26],
  [3], [2 (Зам.)], [ИИ.201-2026], [Сидоров], [20.11.26]
)

= 2. Содержание изменений
1. *Изм. 1:* Корректировка трассировки шины питания интерфейса Ethernet.
2. *Изм. 2:* Введение радиатора пассивного охлаждения центрального процессора.
3. *Изм. 3:* Замена электролитических конденсаторов на танталовые повышенной надежности.
