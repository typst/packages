#import "@preview/eskd-drafting:0.1.0": *

// Пример: Служебные надписи под внешней рамкой (графы 31 и 32 ГОСТ 2.104-2006)
// Демонстрирует:
// 1. Графу 31 («Копировал»): copier: [Федоров] (ширина 120 мм);
// 2. Графу 32 («Формат»): format: auto (ширина 65 мм, автоопределение из paper: "a4" -> "Формат А4");
// 3. Сохранение служебных надписей при переходе с листа 1 (Форма 1) на последующие (Форма 2а).

#show: eskd-document.with(
  paper: "a4",                                 // Формат листа А4
  orientation: "portrait",                     // Вертикальная ориентация

  // Служебные графы 31 и 32 под внешней рабочей рамкой листа (ГОСТ 2.104-2006):
  copier: [Федоров],                           // Графа 31: Фамилия копировщика (120 мм)
  format: auto,                                // Графа 32: Обозначение формата (65 мм, auto -> "Формат А4")

  // Графы 10–13: Подписи участников
  members: (
    ("Разраб.", "Иванов И.И.",  "01.06.26"),
    ("Пров.",   "Петров П.П.",  "03.06.26"),
    ("Т.контр.","Васильев В.В.","04.06.26"),
    ("Н.контр.","Кузнецов К.К.","05.06.26"),
    ("Утв.",    "Смирнов С.С.", "06.06.26"),
  ),

  // Основные графы штампа по ГОСТ 2.104-2006:
  code: [АБВГ.123456.001],                    // Графа 2: Обозначение чертежа
  name: [Узел сопряжения\ Сборочный чертеж],  // Графа 1: Наименование
  org: [Конструкторское бюро],                 // Графа 9: Организация
  lit: [О1],                                   // Графа 4: Литера
  mass: [2,15],                                // Графа 5: Масса в кг
  scale: [1:1],                                // Графа 6: Масштаб
)

// Лист 1: Сборочный чертеж (Форма 1) со служебными графами 31 и 32
#show: page-first-form1

#align(center + horizon)[
  #rect(width: 155mm, height: 160mm, stroke: 0.8mm)[
    #align(center + horizon)[
      #gost-text(h: h7_0, weight: "bold")[СЛУЖЕБНЫЕ НАДПИСИ ПОД РАМКОЙ]\
      #v(6mm)
      #rect(width: 100mm, height: 50mm, stroke: 0.5mm)[
        #align(center + horizon)[#gost-text(h: h3_5)[Габаритный эскиз узла]]
      ]
      #v(6mm)
      #gost-text(h: h3_5)[В нижнем правом углу под внешней рамкой:\ графа 31 («Копировал Федоров») и графа 32 («Формат А4»)]
    ]
  ]
]

// Лист 2: Последующий лист (Форма 2а) со сквозными служебными графами
#show: page-body

= 1. Назначение служебных граф 31 и 32 (ГОСТ 2.104-2006)
Графы 31 и 32 располагаются на нижнем 5-мм поле листа непосредственно под основной надписью (ширина блока 185 мм):

- Графа 31 («Копировал», 120 мм): указывает фамилию лица, выполнившего копирование или тиражирование чертежа;
- Графа 32 («Формат», 65 мм): указывает обозначение формата бумажного листа по ГОСТ 2.301-68. При копировании или подготовке к архивному учету обозначение формата заполняется автоматически на всех листах комплекта.
