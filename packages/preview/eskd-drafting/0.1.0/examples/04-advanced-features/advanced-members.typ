#import "@preview/eskd-drafting:0.1.0": *

// Пример: Продвинутая настройка участников документа (графы 10-13 ГОСТ 2.104-2006)
// Демонстрирует:
// 1. Плоские кортежи ("Должность", "Фамилия", "Дата", "Подпись")
// 2. Словари с индивидуальной настройкой высот шрифтов для конкретных строк
// 3. Гармонизацию кегля для всей колонки фамилий
// 4. Многостраничный переход с первого листа на последующие

#show: eskd-document.with(
  paper: "a4",                                 // Формат листа А4
  orientation: "portrait",                     // Вертикальная ориентация
  members: (
    // Строка 1: Словарь с точечным управлением кеглем должности (label-size) и фамилии (name-size)
    (label: [Гл. констр.], name: [Александров], date: [10.05.26], label-size: h2_5, name-size: h3_5),
    // Строка 2: 4-элементный кортеж ("Должность", "Фамилия", "Дата", "Подпись")
    ("Разраб.", "Иванов И.И.",  "12.05.26", [Ивн]),
    // Строка 3: 4-элементный кортеж с подписью
    ("Пров.",   "Петров П.П.",  "14.05.26", [Пет]),
    // Строка 4: Пустой кортеж () — пустая строка-разделитель в блоке подписей
    (),
    // Строка 5: Нормоконтроль
    ("Н.контр.","Кузнецов",     "15.05.26", [Куз]),
    // Строка 6: Утвердил (максимум 6 строк для Формы 1 по ГОСТ 2.104-2006)
    ("Утв.",    "Смирнов",      "16.05.26", [Смир]),
  ),
  code: [АБВГ.112233.001СБ],                   // Графа 2: Обозначение сборочного чертежа
  name: [Устройство индикации\ Сборочный чертеж], // Графа 1: Наименование
  org: [Опытное производство],                 // Графа 9: Организация
  lit: [О1],                                   // Графа 4: Литера
  mass: [0,42],                                // Графа 5: Масса в кг
  scale: [1:1],                                // Графа 6: Масштаб
)

// Лист 1: Сборочный чертеж (Форма 1 55 мм, 6 строк подписей)
#show: page-first-form1

#align(center + horizon)[
  #rect(width: 155mm, height: 160mm, stroke: 0.8mm)[
    #align(center + horizon)[
      #gost-text(h: h7_0, weight: "bold")[УСТРОЙСТВО ИНДИКАЦИИ]\
      #v(6mm)
      #rect(width: 80mm, height: 40mm, stroke: 0.5mm)[
        #align(center + horizon)[#gost-text(h: h3_5)[Светодиодная панель]]
      ]
      #v(6mm)
      #gost-text(h: h3_5)[1 — Лицевая панель; 2 — Плата коммутации; 3 — Крепеж]
    ]
  ]
]

// Лист 2: Технические требования (Форма 2а 15 мм)
#show: page-body

= 1. Технические требования к сборке
1. Пайку элементов производить припоем ПОС-61 по ГОСТ 21930-76.
2. Остатки флюса удалить смывкой спирто-бензиновой смесью 1:1.
3. Покрытие лицевой панели: Эмаль МЛ-12 черная ГОСТ 9754-76.
4. Неуказанные предельные отклонения размеров: $H 14$, $h 14$, $plus.minus (I T 14)/2$.