// ============================================================
// figment · theme
// 配色与尺寸常量。全部可被 set-theme() 覆盖，单独使用时可整体替换。
// ============================================================

#let theme = (
  // ---- 颜色 ----
  line: rgb("#1f3a5f"),        // 主线条（深蓝黑）
  node: rgb("#2b5f8e"),        // 结点描边
  fill: rgb("#dbe9f7"),        // 浅蓝填充（高亮/已访问）
  fill2: rgb("#eef4fb"),       // 更浅填充（数组格底）
  accent: rgb("#c8452f"),      // 强调（当前结点/答案）
  gray: rgb("#8b98a5"),        // 辅助线/虚边
  text: rgb("#1a1a1a"),
  visited: rgb("#dbe9f7"),     // 已访问
  current: rgb("#f6d9d2"),     // 当前处理
  answer: rgb("#e3f0dc"),      // 答案路径
  // ---- 尺寸 ----
  lw: 0.85pt,                  // 主线条宽
  lw-thin: 0.6pt,              // 辅助线宽
  r: 0.30,                     // 结点半径
  fs: 8pt,                     // 图内字号
  fs-sm: 7pt,                  // 小字
  cw: 0.66,                    // 数组格宽
  ch: 0.62,                    // 数组格高
  dx: 1.40,                    // 层间横向间距
  dy: 1.10,                    // 层间纵向间距
)

// 允许整体替换主题（返回新字典，不改全局）
#let with-theme(base, patch) = base + patch
