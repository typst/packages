// The list of the used AI tools ("Használt Mesterséges Intelligencia Eszközök") required by the AI instruction
// (18/2026. rector's instruction, see template.typ), the section numbers below are its. Typst only supports a
// single bibliography, so the entries are figures of their own kind, numbered [AI1], [AI2], ... and referenced with
// `@label` like bibliography entries.

#import "problem.typ": problem

// An entry of the used AI tools list, with the fields required by 18.§ (4) a and annex 1, III (2): "Használt AI
// rendszer fejlesztője, az AI rendszer megnevezése, típusa, verziója, használat módja (...), a generálás időpontja"
// `date` is a `datetime`, or an array of two for a period.
// Put a label after it to reference it, `@ai-example` in the text displays "[AI1]":
// ```
// #ai-tool(
//   developer: [OpenAI],
//   name: [ChatGPT],
//   type: [generative AI chatbot],
//   version: [GPT-5 Thinking],
//   usage: [wording a comparison of heat exchanger types based on my own outline],
//   date: datetime(year: 2026, month: 9, day: 14),
// ) <ai-example>
// ```
// -> "[AI1] OpenAI, ChatGPT, generative AI chatbot, GPT-5 Thinking, wording a comparison of heat exchanger types
// based on my own outline, generation date: 2026. 09. 14."
#let ai-tool(
  developer: none,
  name: none,
  type: none,
  version: none,
  usage: none,
  date: none,
) = {
  let fields = (developer: developer, name: name, type: type, version: version, usage: usage, date: date)
  for (field, value) in fields {
    assert(value != none, message: "the `" + field + "` field of an AI tool entry is required (18.§ (4) a)")
  }
  let dates = if std.type(date) == array { date } else { (date,) }
  assert(
    dates.len() in (1, 2) and dates.all(d => std.type(d) == datetime),
    message: "the `date` of an AI tool entry must be a `datetime` or an array of two `datetime`s (a period)",
  )

  // "a generálás időpontja" in the rector's instruction
  let date-label = context (hu: "generálás időpontja").at(text.lang, default: "generation date")
  // the "[év.hó.nap]" (year.month.day) format of the rector's instruction, e.g. "2026. 10. 11."
  let date-text = dates.map(date => date.display("[year]. [month]. [day].")).join[ -- ]
  figure(
    kind: "ai",
    supplement: none,
    numbering: n => "[AI" + str(n) + "]",
    outlined: false,
    [#developer, #name, #type, #version, #usage, #date-label: #date-text],
  )
}

// Text generated by AI has to be set in italics, followed by a reference to the AI tool (18.§ (3) a). Only for text
// that the AI wrote, the author's own sentences mentioning AI use just reference the tool (`... with the help of AI
// @ai-example.`), and so do AI-generated figures and code (18.§ (3) b).
// `#ai-generated(<ai-example>)[The text written by AI.]` -> "_The text written by AI._ [AI1]"
#let ai-generated(label, body) = emph(body) + [ ] + ref(label)

// Displays the entries like bibliography entries, the number links to the first reference
#let ai-tools-style(draft: true, body) = {
  show figure.where(kind: "ai"): it => context {
    let number = it.counter.display(it.numbering)
    // the AI tool has to be referenced after the content it generated (18.§ (3)), so an entry that is never
    // referenced means AI use that isn't marked in the text
    let references = if it.has("label") { query(ref.where(target: it.label)) } else { () }
    let message = if not it.has("label") {
      (
        "AI tool entry "
          + number
          + " has no label, put one after it (`#ai-tool(...) <ai-example>`) and reference "
          + "it after the content it generated (`@ai-example`)"
      )
    } else if references == () {
      (
        "AI tool entry "
          + number
          + " (`"
          + repr(it.label)
          + "`) is never referenced, reference it after the "
          + "content it generated (`@"
          + str(it.label)
          + "`)"
      )
    }
    block(
      width: 100%,
      align(left, grid(
        columns: (auto, 1fr),
        column-gutter: 0.75em,
        if references == () { number } else { link(references.first().location(), number) },
        it.body + if message != none { linebreak() + problem(draft, message) },
      )),
    )
  }
  body
}
