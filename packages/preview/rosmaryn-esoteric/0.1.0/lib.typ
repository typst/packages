// Rosmaryn Esoteric symbols for Typst. Requires the "Rosmaryn Esoteric" font to be installed
// (https://github.com/Rosmaryn-Dev/rosmaryn-esoteric-font). Each symbol is its Unicode character set in that font.

#let font-name = "Rosmaryn Esoteric"

/// Sets any text in the Rosmaryn Esoteric font.
#let esoteric(body) = text(font: font-name, body)

