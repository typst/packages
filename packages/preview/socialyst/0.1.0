[package]
name = "socialyst"
version = "0.1.0"
entrypoint = "lib.typ"
authors = ["FERGOUS Abdelhak <@fergousA>"]
license = "MIT"
description = "Social-network post boxes for Typst (Twitter/X, Facebook, Instagram, Snapchat, Mastodon)."
compiler = "0.15.0"
categories = ["components"]
disciplines = ["education", "communication"]
keywords = ["twitter", "facebook", "instagram", "snapchat", "mastodon", "social", "boxes", "rtl"]
exclude = [
  "/pages/*",
  "/examples/*.pdf",
]
