// Sans-serif used for headings, box titles, and eyebrow labels. Inter is the
// recommended choice (see README) but isn't bundled with Typst, so this
// falls back to common system sans-serif fonts if it isn't installed.
#let heading-font = (
  "Inter",
  "Helvetica Neue",
  "Helvetica",
  "Arial",
  "Liberation Sans",
  "DejaVu Sans",
  "Noto Sans",
)
