<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="sort-only" default-locale="pl-PL">
  <!--
    Numeric style modelled on the "Wykaz literatury" sample from the
    Gdańsk University of Technology diploma thesis guidelines
    (Załącznik nr 2/3 do Regulaminu procesu dyplomowania PG, ZR 53/2022):

      [1] Kowalski J., Kabacki J.: Simulation of Network Systems in Education,
          Proceedings of ..., Ostrava, Czechy, s. 213–218.
      [2] National Center of Biotechnology Information, http://www.ncbi.nlm.nih.gov,
          (data dostępu 20.12.2012 r.).
      [3] Nowak K.: Dydaktyczny model ... Projekt dyplomowy inżynierski. WETI PG, 2002.
      [4] Barzykowski J. i inni: Współczesna metrologia – zagadnienia wybrane.
          WNT, Warszawa 2004, s. 575.

    Entries are numbered in order of first citation (PN-ISO 690, numeric method).
  -->
  <info>
    <title>Gdańsk University of Technology – numeric (PN-ISO 690)</title>
    <id>pg-unofficial-thesis-numeric</id>
    <category citation-format="numeric"/>
    <updated>2026-10-17T00:00:00+00:00</updated>
  </info>
  <locale xml:lang="pl">
    <date form="numeric">
      <date-part name="day" form="numeric-leading-zeros" suffix="."/>
      <date-part name="month" form="numeric-leading-zeros" suffix="."/>
      <date-part name="year" suffix=" r."/>
    </date>
    <terms>
      <term name="accessed">data dostępu</term>
      <term name="et-al">i inni</term>
      <term name="and others">i inni</term>
      <term name="edition" form="short">wyd.</term>
      <term name="issue" form="short">nr</term>
      <term name="volume" form="short">t.</term>
      <term name="page" form="short">
        <single>s.</single>
        <multiple>s.</multiple>
      </term>
      <term name="in">W</term>
    </terms>
  </locale>
  <locale xml:lang="en">
    <date form="numeric">
      <date-part name="day" form="numeric-leading-zeros" suffix="."/>
      <date-part name="month" form="numeric-leading-zeros" suffix="."/>
      <date-part name="year"/>
    </date>
    <terms>
      <term name="accessed">date of access</term>
      <term name="et-al">et al.</term>
      <term name="edition" form="short">ed.</term>
      <term name="issue" form="short">no.</term>
      <term name="volume" form="short">vol.</term>
      <term name="page" form="short">
        <single>p.</single>
        <multiple>pp.</multiple>
      </term>
      <term name="in">In</term>
    </terms>
  </locale>

  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=" " initialize-with="." delimiter=", " delimiter-precedes-last="always" et-al-min="4" et-al-use-first="1"/>
      <et-al term="et-al" prefix=" "/>
      <substitute>
        <names variable="editor"/>
      </substitute>
    </names>
  </macro>
  <macro name="title">
    <text variable="title"/>
  </macro>
  <macro name="year">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>
  <macro name="author-title">
    <choose>
      <if variable="author editor" match="any">
        <group delimiter=": ">
          <text macro="author"/>
          <text macro="title"/>
        </group>
      </if>
      <else>
        <text macro="title"/>
      </else>
    </choose>
  </macro>
  <macro name="container">
    <group delimiter=", ">
      <text variable="container-title"/>
      <group delimiter=" ">
        <text term="volume" form="short"/>
        <text variable="volume"/>
      </group>
      <group delimiter=" ">
        <text term="issue" form="short"/>
        <text variable="issue"/>
      </group>
    </group>
  </macro>
  <macro name="publisher-place-year">
    <group delimiter=", ">
      <text variable="publisher"/>
      <group delimiter=" ">
        <text variable="publisher-place"/>
        <text macro="year"/>
      </group>
    </group>
  </macro>
  <macro name="pages">
    <group delimiter=" ">
      <label variable="page" form="short"/>
      <text variable="page"/>
    </group>
  </macro>
  <macro name="locators">
    <group delimiter=", ">
      <text macro="pages"/>
      <text variable="DOI" prefix="DOI: "/>
      <text variable="URL"/>
      <group prefix="(" suffix=")" delimiter=" ">
        <text term="accessed"/>
        <date variable="accessed" form="numeric"/>
      </group>
    </group>
  </macro>

  <citation collapse="citation-number">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout prefix="[" suffix="]" delimiter=", ">
      <group delimiter=", ">
        <text variable="citation-number"/>
        <group delimiter=" ">
          <label variable="locator" form="short"/>
          <text variable="locator"/>
        </group>
      </group>
    </layout>
  </citation>

  <bibliography second-field-align="flush" entry-spacing="0">
    <layout suffix=".">
      <text variable="citation-number" prefix="[" suffix="]"/>
      <choose>
        <!-- Monographs: "Author: Title. [Genre.] Publisher, Place Year, s. N." -->
        <if type="book thesis report manuscript" match="any">
          <group delimiter=". ">
            <text macro="author-title"/>
            <group delimiter=", ">
              <group delimiter=". ">
                <group delimiter=" ">
                  <text variable="edition"/>
                  <text term="edition" form="short"/>
                </group>
                <text variable="genre"/>
                <text macro="publisher-place-year"/>
              </group>
              <text macro="locators"/>
            </group>
          </group>
        </if>
        <!-- Parts of larger works: "Author: Title, Container, Place Year, s. A–B." -->
        <else-if type="article-journal article-magazine article-newspaper chapter paper-conference entry-encyclopedia entry-dictionary" match="any">
          <group delimiter=", ">
            <text macro="author-title"/>
            <text macro="container"/>
            <text macro="publisher-place-year"/>
            <text macro="locators"/>
          </group>
        </else-if>
        <!-- Web pages, software, standards and everything else. -->
        <else>
          <group delimiter=", ">
            <text macro="author-title"/>
            <text macro="container"/>
            <text variable="genre"/>
            <text variable="number"/>
            <text macro="publisher-place-year"/>
            <text macro="locators"/>
          </group>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
