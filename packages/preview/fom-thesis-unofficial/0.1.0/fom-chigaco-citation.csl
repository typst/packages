<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="note" version="1.0" default-locale="de-DE">
  <info>
    <title>FOM Chicago Zitierstil Ver. 2024 for Typst</title>
    <id>https://github.com/FinnRiedel/fom-chigaco-citation</id>
    <author>
      <name>Finn Riedel</name>
    </author>
    <category citation-format="note"/>
    <updated>2026-03-31T00:00:00+00:00</updated>
    <rights license="https://www.gnu.org/licenses/gpl-3.0">GPL-3.0</rights>
  </info>

  <!-- Vgl. Leitfaden S. 32 
  Sollte der Autor, das Datum oder der Ort aus einer Quelle fehlen,
  so wird die Abkürzung für "ohne Verfasser/Jahr/Ort" verwendet.
  -->
  <macro name="no-author"><text value="o. V."/></macro>
  <macro name="no-date"><text value="o. J."/></macro>
  <macro name="no-place"><text value="o. O."/></macro>

  <!-- Vgl. Leitfaden S. 30 
  Der Name in Fußnoten wird wie folgt formatiert: Nachname, V. (italic).
  -->
  <macro name="author-footnote">
    <names variable="author">
      <!-- Name, V. italic-->
      <name form="long" name-as-sort-order="all" sort-separator=", " initialize-with=". " delimiter=", " font-style="italic"/>
      <substitute>
        <names variable="editor"/>
        <text macro="no-author"/>
      </substitute>
    </names>
  </macro>

  <!-- Vgl. Leitfaden S. 17
  Der Name des Verfassers im Literaturverzeichnis wird wie folgt formatiert: Nachname, Vorname (italic).
  -->
  <macro name="author-bib">
    <names variable="author">
      <name form="long" name-as-sort-order="all" sort-separator=", " delimiter=", " font-style="italic"/>
      <label form="short" prefix=" (" suffix=")"/>
      <substitute>
        <names variable="editor"/>
        <text macro="no-author"/>
      </substitute>
    </names>
  </macro>

  <!-- Vgl. Leitfaden S. 30
  Das Stichwort wird sowohl in den Fußnoten, als auch im Literaturverzeichnis nach den Autoren gennant. Dabei wird das Stichwort mit dem Erscheinungsjahr in Klammern gesetzt.
  Zum Beispiel: Nachname, V. (Stichwort, 2026).
  -->
  <macro name="stichwort-jahr">
    <group prefix="(" suffix="):" delimiter=", ">
      <text variable="title-short"/>
      <choose>
        <if variable="issued">
          <date variable="issued"><date-part name="year"/></date>
        </if>
        <else>
          <text macro="no-date"/>
        </else>
      </choose>
    </group>
  </macro>

  <!-- Vgl. Leitfaden S. 16
  Der Verlag wird im Literaturverzeichnis zunächst mit dem Ort und dann dem Verlagsnamen genannt und wie folgt formatiert: Köln: Springer
  -->
  <macro name="publisher-info">
    <group delimiter=": ">
      <choose>
        <if variable="publisher-place"><text variable="publisher-place"/></if>
        <else><text macro="no-place"/></else>
      </choose>
      <choose>
        <if variable="publisher"><text variable="publisher"/></if>
        <else><text macro="no-author"/></else>
      </choose>
    </group>
  </macro>

  <macro name="locator-footnote">
    <group delimiter=" ">
      <label variable="locator" form="short"/>
      <text variable="locator"/>
    </group>
  </macro>


<!-- Fußnote -->
  
  <!--
  Sobald drei oder mehr Autoren aufgeführt sind, wird nur der erste genannt, gefolgt von "et al.".
  -->
  <citation et-al-min="3" et-al-use-first="1">
    <layout suffix="." delimiter="; ">
      <choose>
        <!-- Wenn dieselbe Quelle mit anderer Seitenzahl zitiert wird, dann zeige "ebd., S. XY" -->
        <if position="ibid-with-locator">
          <group delimiter=", ">
            <text value="ebd."/>
            <text macro="locator-footnote"/>
          </group>
        </if>
        <!-- Wenn dieselbe Quelle und Seitenzahl zitiert wird, zeige nur "ebd." -->
        <else-if position="ibid">
          <text value="ebd."/>
        </else-if>
        <else>
        <!-- Sollten diese Bedingungen nicht zutreffen, zitiere normal: -->
          <group delimiter=", ">
            <text macro="author-footnote"/>
            <text variable="title-short"/>
            <choose>
              <if variable="issued"><date variable="issued"><date-part name="year"/></date></if>
              <else><text macro="no-date"/></else>
            </choose>
            <text macro="locator-footnote"/>
          </group>
        </else>
      </choose>
    </layout>
  </citation>

<!-- Literaturverzeichnis -->

  <!-- Einrückung in den Zeilen unter dem Autor-->
  <bibliography hanging-indent="true" subsequent-author-substitute="———">
    <!-- Sortierung nach Nachnamen der Autoren; bei gleichem Autor nach Erscheinungsjahr -->
    <sort>
      <key macro="author-bib"/>
      <key variable="issued"/>
    </sort>
    <layout>
      <group delimiter=" ">
        <!-- Jede Quelle beginnt mit Autoren und Stichwort (Typunabhängig) -->
        <text macro="author-bib"/>
        <text macro="stichwort-jahr"/>

        <!-- Je nach Quelltyp wird unterschieden: -->
        <choose>

          <!-- Internetquelle -->
          <if type="webpage post-weblog" match="any">
            <group delimiter=", ">
              <text variable="title"/>
              <text variable="container-title"/>
              <group delimiter=" ">
                <text variable="URL" prefix="&lt;" suffix="&gt;"/>
                <choose>
                  <if variable="issued"><date variable="issued" prefix="(" suffix=")"><date-part name="year" suffix="-"/><date-part name="month" form="numeric-leading-zeros" suffix="-"/><date-part name="day" form="numeric-leading-zeros"/></date></if>
                </choose>
                <group prefix="[Zugriff " suffix="]">
                  <date variable="accessed">
                    <date-part name="year" suffix="-"/>
                    <date-part name="month" form="numeric-leading-zeros" suffix="-"/>
                    <date-part name="day" form="numeric-leading-zeros"/>
                  </date>
                </group>
              </group>
            </group>
          </if>

          <!-- Artikel und Artikel aus Zeitschrift -->
          <else-if type="article article-journal" match="any">
            <group delimiter=", ">
              <text variable="title"/>
              <group delimiter=": ">
                <text value="in"/>
                <text variable="container-title"/>
              </group>
              <group delimiter=" ">
                <text variable="volume"/>
                <date variable="issued" prefix="(" suffix=")"><date-part name="year"/></date>
              </group>
              <group delimiter=" ">
                <text value="Nr."/>
                <text variable="issue"/>
              </group>
              <group delimiter=" ">
                <label variable="page" form="short"/>
                <text variable="page"/>
              </group>
            </group>
          </else-if>

          <!-- Sammelwerke -->
          <else-if type="chapter paper-conference" match="any">
            <group delimiter=", ">
              <text variable="title"/>
              <group delimiter=": ">
                <text value="in"/>
                <names variable="editor">
                  <name form="long" name-as-sort-order="all" sort-separator=", " delimiter=", " font-style="italic"/>
                  <label form="short" prefix=" (" suffix=")"/>
                </names>
              </group>
              <text variable="container-title"/>
              <!--<text macro="publisher-info"/> Der Verlag wird bei Artikeln aus Sammelwerken nicht genannt-->
              <date variable="issued"><date-part name="year"/></date>
              <group delimiter=" ">
                <label variable="page" form="short"/>
                <text variable="page"/>
              </group>
            </group>
          </else-if>

          <!-- Monografien / Bücher -->
          <else>
            <group delimiter=", ">
              <text variable="title"/>
              <text variable="edition" suffix=". Aufl."/>
              <text macro="publisher-info"/>
              <date variable="issued"><date-part name="year"/></date>
            </group>
          </else>
        </choose>
      </group>
    </layout>
  </bibliography>
</style>