// 全局计数器 —— 正文与索引类页面共用，必须放在共享模块里。
//
// 注意：这些计数器原定义在 layouts/mainmatter.typ 内部，索引页（pages/list-of-*.typ）
//    拿不到，于是索引只能退回 Typst 的默认编号，导致「图 1.1」变成「图 1」，
//    而且想按元素位置求章号时会直接报 unknown variable: 章号
//    —— 真实论文（112 页压力测试）实测踩到。

// 「当前正在渲染索引类页面」—— 供 索引题注() 判断该显示哪一版题注。
// 插图索引 / 表格索引 在渲染条目前置为 true，渲染完置回 false。
#let 索引中 = state("xdu-索引中", false)

// 双题注：索引里显示第一个，正文里显示第二个 —— 相当于 LaTeX 的 `\caption[短]{长}`。
// 用途：题注太长时，索引里只放简短版本；题注里必须写引用时，索引版省掉引用。
//
//   #figure(img, caption: 索引题注([系统框图], [毫米波大规模 MIMO 系统框图 @zhang2023]))
//
// 注：题注里的引用**默认已被索引页自动隐藏**（见 pages/list-of-*.typ 的 show cite 规则），
// 所以只有在想额外精简索引文字时才需要用它。
#let 索引题注(索引版, 正文版) = context {
  if 索引中.get() { 索引版 } else { 正文版 }
}

// 章计数器：每个一级标题 +1，并在每章开头重置图/表/公式的章内序号
#let 章号 = counter("xdu-章号")
#let 图号 = counter("xdu-图号")
#let 表号 = counter("xdu-表号")
#let 公式号 = counter("xdu-公式号")

// 章号的中文数字（第一章 → 一）—— 硕士 layouts/mainmatter.typ 与本科 bachelor/layout.typ
// 共用同一份数据（两边都用来拼「第X章」，取值完全一致，抽到这里纯粹去重，不改变任何一侧的输出）。
#let 汉字序 = (
  "一", "二", "三", "四", "五", "六", "七", "八", "九", "十",
  "十一", "十二", "十三", "十四", "十五", "十六", "十七", "十八", "十九", "二十",
)
