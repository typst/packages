/// Draw ornament `n` of `family` ("vectorian", "han", "am") at `width`.
#let pgfornament(n, family: "vectorian", width: 1.2cm, paint: black,
  thickness: 0.5pt) = {
  let fi = if family == "vectorian" { 0 }
           else if family == "han" { 1 }
           else if family == "am" { 2 }
           else { panic("unknown ornament family: " + family) }
  let fam = _DATA.at(fi)
  if n < 1 or n > fam.len() {
    panic("ornament out of range for family " + family + ": " + str(n))
  }
  let d = fam.at(n - 1)
  if d == none { return none }
  let X = d.at(0) * 1pt
  let Y = d.at(1) * 1pt
  // one scale factor, applied straight to the coordinates: Typst's
  // `scale()` keeps the pre-scale layout size, which would let the
  // drawing escape its box.
  let f = width / X
  let fy = (yy) => (d.at(1) - yy) * f
  box(width: width, height: Y * f, {
    for piece in d.at(2) {
      let ops = ()
      for op in piece {
        let k = op.at(0)
        if k == "m" {
          ops += (curve.move((op.at(1) * f * 1pt, fy(op.at(2)) * 1pt)),)
        } else if k == "l" {
          ops += (curve.line((op.at(1) * f * 1pt, fy(op.at(2)) * 1pt)),)
        } else if k == "c" {
          ops += (curve.cubic(
            (op.at(1) * f * 1pt, fy(op.at(2)) * 1pt),
            (op.at(3) * f * 1pt, fy(op.at(4)) * 1pt),
            (op.at(5) * f * 1pt, fy(op.at(6)) * 1pt)),)
        }
      }
      place(top + left, curve(fill: paint,
        stroke: (paint: paint, thickness: thickness), ..ops))
    }
  })
}
