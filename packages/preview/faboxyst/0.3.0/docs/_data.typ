  (id: "banners", en: "Slide components III — banners, folders and hand-drawn pieces", fr: "Composants de diapositive III — bannières, chemises et pièces dessinées à la main", intro-en: "Banners and ribbons, folder and tab boxes, speech bubbles, pencil-sketch shapes and other hand-drawn call-outs.", intro-fr: "Bannières et rubans, boîtes en chemise ou à onglet, bulles, formes au crayon et autres appels dessinés à la main.", names: ("folded-banner","banners-with-circles","hand-drawn-speech-bubbles","tabbed-folder-box","perspective-text-box","peak-header-box","pocket-card-box","folder-text-block","folder-text-box","vertical-banner-box","hexagonal-header-box","horizontal-bubble-box","staggered-hanging-card-box","diagonal-banner-card-box","rounded-tab-card-box","side-banner-card-box","top-banner-card-box","stacked-banner-row","perspective-panels","folded-banner-info-box","folding-card-box","six-boxes-folder-card","postage-stamp-card","hand-drawn-bullet-panel","hand-drawn-business-callout","hand-drawn-folded-ribbon","hand-drawn-photo-frame","hand-drawn-business-brochure-card","pencil-sketch-box","pencil-sketch-ellipse","pencil-sketch-graphite-box","text-box-tag"), values: ()),
  (id: "infographics", en: "Infographic cards, stacks and compound frames", fr: "Cartes, piles et cadres composés d'infographie", intro-en: "Slide-template infographics drawn with nibart pens (broad-nib outlines, soft shadows, smooth Hobby curves): card rows (puzzle notch, folded tab, half-disc tab, U backing, outlines, timeline), linked stacks (rings, wires, brush strokes, ribbons, bubbles, posters) and compound pieces (pencil frame, index notebook, film strip, slideshow frame). Every one takes `steps:` (title, body, icon, label, colour), `width`, `height`, `direction` and mirrors in RTL.", intro-fr: "Infographies de modèles de diapositives dessinées avec les plumes de nibart (contours à plume large, ombres douces, courbes de Hobby) : rangées de cartes (encoche puzzle, onglet plié, onglet demi-disque, fond en U, contours, frise), piles reliées (anneaux, fils, coups de pinceau, rubans, bulles, affiches) et pièces composées (cadre de crayons, cahier à onglets, pellicule, visionneuse). Toutes prennent `steps:` (title, body, icon, label, colour), `width`, `height`, `direction` et se mettent en miroir en RTL.", names: ("puzzle-tab-cards", "folded-tab-cards", "half-disc-tab-cards", "u-backed-cards", "circle-head-outline-cards", "dashed-pill-cards", "skewed-badge-cards", "badge-timeline-cards", "ring-linked-boxes", "wire-linked-pills", "brush-stroke-rows", "twisted-ribbon-rows", "bubble-tail-boxes", "striped-poster-cards", "pencil-frame-flow", "index-notebook", "film-strip", "chevron-slideshow-frame"), values: ()),
  (id: "sketchframes", en: "Sketched frames: ink, charcoal, crayon, pencil", fr: "Cadres dessinés : encre, fusain, crayon gras, crayon", intro-en: "Frames for a block of content, drawn with nibart pens (dry media use nibart's `pressure` so the stroke breaks up like grain): the vintage ink frame (with oval, twin or bevelled \"THE END\" windows), charcoal hatching, wax-crayon scribbles and pencil outlines. They take the content as first argument.", intro-fr: "Cadres pour un bloc de contenu, dessinés avec les plumes de nibart (les médias secs utilisent `pressure` pour que le trait se brise comme un grain) : cadre d'encre vintage (fenêtres ovale, jumelles ou panneau « THE END » biseauté), hachures de fusain, griffonnages de crayon gras et contours de crayon. Le contenu est le premier argument.", names: ("vintage-frame", "charcoal-frame", "crayon-frame", "pencil-sketch-frame"), values: ()),
)
