  "vintage-frame": (en: "Inked frame: thick outline, fine inner lines, corner hatches; optional oval / twin windows or a bevelled panel.", fr: "Cadre à l'encre : contour épais, filets fins, hachures d'angle ; fenêtres ovale / jumelles ou panneau biseauté en option.", sig: "vintage-frame(body, width: auto, height: 7cm, direction: auto, window: none, inner: none, ink: black, thickness: 2.6pt, seed: 4, align: center + horizon)", params: ((n: "body", d: "required", en: "The content placed in the frame.", fr: "Le contenu placé dans le cadre."),(n: "width", d: "auto", en: "Width (`auto`: the line).", fr: "Largeur (`auto` : toute la ligne)."),(n: "height", d: "7cm", en: "Height of the drawing (`auto` where the height follows the rows).", fr: "Hauteur du dessin (`auto` quand la hauteur suit les lignes)."),(n: "direction", d: "auto", en: "Text direction: `auto` follows the document **or the content** (Arabic is detected), or `ltr` / `rtl`; the layout mirrors in RTL.", fr: "Direction du texte : `auto` suit le document **ou le contenu** (l'arabe est détecté), ou `ltr` / `rtl` ; la mise en page se met en miroir en RTL."),(n: "window", d: "none", en: "Window: `none`, `\"oval\"`, `\"rect\"`, `\"twin-oval\"`, `\"twin-rect\"` (for the twin ones give `body` as an array of two contents).", fr: "Fenêtre : `none`, `\"oval\"`, `\"rect\"`, `\"twin-oval\"`, `\"twin-rect\"` (pour les jumelles, donner `body` sous forme d'un tableau de deux contenus)."),(n: "inner", d: "none", en: "`none` or `\"bevel\"` (grey chamfered panel, \"THE END\" style).", fr: "`none` ou `\"bevel\"` (panneau gris à coins coupés, style « THE END »)."),(n: "ink", d: "black", en: "Ink colour.", fr: "Couleur de l'encre."),(n: "thickness", d: "2.6pt", en: "Thickness of the pencils.", fr: "Épaisseur des crayons."),(n: "seed", d: "4", en: "Seed of the hand-drawn irregularities.", fr: "Graine des irrégularités dessinées à la main."),(n: "align", d: "center + horizon", en: "Alignment of the content in the frame.", fr: "Alignement du contenu dans le cadre."),), fit: 0.5, ex: "#vintage-frame(window: \"oval\", height: 5cm)[Invitation]", code: none),
  "charcoal-frame": (en: "Charcoal hatching round the content, rectangular or elliptic.", fr: "Hachures au fusain autour du contenu, rectangulaire ou elliptique.", sig: "charcoal-frame(body, width: auto, height: 7cm, direction: auto, shape: \"rect\", ink: luma(35), density: 1.0, band: 0.3, weight: 100%, seed: 11, align: center + horizon)", params: ((n: "body", d: "required", en: "The content placed in the frame.", fr: "Le contenu placé dans le cadre."),(n: "width", d: "auto", en: "Width (`auto`: the line).", fr: "Largeur (`auto` : toute la ligne)."),(n: "height", d: "7cm", en: "Height of the drawing (`auto` where the height follows the rows).", fr: "Hauteur du dessin (`auto` quand la hauteur suit les lignes)."),(n: "direction", d: "auto", en: "Text direction: `auto` follows the document **or the content** (Arabic is detected), or `ltr` / `rtl`; the layout mirrors in RTL.", fr: "Direction du texte : `auto` suit le document **ou le contenu** (l'arabe est détecté), ou `ltr` / `rtl` ; la mise en page se met en miroir en RTL."),(n: "shape", d: "\"rect\"", en: "`\"rect\"` or `\"ellipse\"`.", fr: "`\"rect\"` ou `\"ellipse\"`."),(n: "ink", d: "luma(35)", en: "Ink colour.", fr: "Couleur de l'encre."),(n: "density", d: "1.0", en: "Density of the strokes (1 = default).", fr: "Densité des traits (1 = défaut)."),(n: "band", d: "0.3", en: "Thickness of the charcoal frame in cm (the hatched band).", fr: "Épaisseur du cadre de fusain en cm (la bande hachurée)."),(n: "weight", d: "100%", en: "Stroke weight multiplier: below 100% gives finer strokes, above gives heavier ones.", fr: "Multiplicateur d'épaisseur du trait : sous 100 % le trait est plus fin, au-dessus plus gras."),(n: "seed", d: "11", en: "Seed of the hand-drawn irregularities.", fr: "Graine des irrégularités dessinées à la main."),(n: "align", d: "center + horizon", en: "Alignment of the content in the frame.", fr: "Alignement du contenu dans le cadre."),), fit: 0.5, ex: "#charcoal-frame(height: 5cm)[Charcoal]", code: none),
  "crayon-frame": (en: "Wax-crayon scribbles in several colours running round the frame.", fr: "Griffonnages de crayon gras de plusieurs couleurs autour du cadre.", sig: "crayon-frame(body, width: auto, height: 7cm, direction: auto, colours: (rgb(\"#8DC21F\"), rgb(\"#FFC800\"), rgb(\"#8AA316\")), band: 0.5, weight: 100%, density: 1.0, seed: 8, align: center + horizon)", params: ((n: "body", d: "required", en: "The content placed in the frame.", fr: "Le contenu placé dans le cadre."),(n: "width", d: "auto", en: "Width (`auto`: the line).", fr: "Largeur (`auto` : toute la ligne)."),(n: "height", d: "7cm", en: "Height of the drawing (`auto` where the height follows the rows).", fr: "Hauteur du dessin (`auto` quand la hauteur suit les lignes)."),(n: "direction", d: "auto", en: "Text direction: `auto` follows the document **or the content** (Arabic is detected), or `ltr` / `rtl`; the layout mirrors in RTL.", fr: "Direction du texte : `auto` suit le document **ou le contenu** (l'arabe est détecté), ou `ltr` / `rtl` ; la mise en page se met en miroir en RTL."),(n: "colours", d: "(rgb(\"#8DC21F\"), rgb(\"#FFC800\"), rgb(\"#8AA316\"))", en: "Colours used in turn by the items.", fr: "Couleurs utilisées tour à tour par les éléments."),(n: "band", d: "0.5", en: "Thickness of the crayon frame in cm (the scribbled band).", fr: "Épaisseur du cadre de crayon en cm (la bande griffonnée)."),(n: "weight", d: "100%", en: "Stroke weight multiplier: below 100% gives finer strokes, above gives heavier ones.", fr: "Multiplicateur d'épaisseur du trait : sous 100 % le trait est plus fin, au-dessus plus gras."),(n: "density", d: "1.0", en: "Density of the strokes (1 = default).", fr: "Densité des traits (1 = défaut)."),(n: "seed", d: "8", en: "Seed of the hand-drawn irregularities.", fr: "Graine des irrégularités dessinées à la main."),(n: "align", d: "center + horizon", en: "Alignment of the content in the frame.", fr: "Alignement du contenu dans le cadre."),), fit: 0.5, ex: "#crayon-frame(height: 5cm)[Crayon]", code: none),
  "pencil-sketch-frame": (en: "Pencil outline: several shaky rectangles, one or two panels, doodled shapes at the foot.", fr: "Contour au crayon : plusieurs rectangles tremblés, un ou deux panneaux, formes griffonnées en bas.", sig: "pencil-sketch-frame(body, width: auto, height: 7cm, direction: auto, panels: 1, doodles: true, ink: luma(45), lines: 3, seed: 6, align: center + horizon)", params: ((n: "body", d: "required", en: "The content placed in the frame.", fr: "Le contenu placé dans le cadre."),(n: "width", d: "auto", en: "Width (`auto`: the line).", fr: "Largeur (`auto` : toute la ligne)."),(n: "height", d: "7cm", en: "Height of the drawing (`auto` where the height follows the rows).", fr: "Hauteur du dessin (`auto` quand la hauteur suit les lignes)."),(n: "direction", d: "auto", en: "Text direction: `auto` follows the document **or the content** (Arabic is detected), or `ltr` / `rtl`; the layout mirrors in RTL.", fr: "Direction du texte : `auto` suit le document **ou le contenu** (l'arabe est détecté), ou `ltr` / `rtl` ; la mise en page se met en miroir en RTL."),(n: "panels", d: "1", en: "Number of panels side by side (1 or 2).", fr: "Nombre de panneaux côte à côte (1 ou 2)."),(n: "doodles", d: "true", en: "Draw the little doodled shapes at the foot.", fr: "Dessiner les petites formes griffonnées en bas."),(n: "ink", d: "luma(45)", en: "Ink colour.", fr: "Couleur de l'encre."),(n: "lines", d: "3", en: "Number of superimposed pencil lines.", fr: "Nombre de traits de crayon superposés."),(n: "seed", d: "6", en: "Seed of the hand-drawn irregularities.", fr: "Graine des irrégularités dessinées à la main."),(n: "align", d: "center + horizon", en: "Alignment of the content in the frame.", fr: "Alignement du contenu dans le cadre."),), fit: 0.5, ex: "#pencil-sketch-frame(height: 5cm)[Pencil]", code: none),
